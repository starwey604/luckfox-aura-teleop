From eab95a16e882495bf016f26c6cffc54d7e6fdb4c Mon Sep 17 00:00:00 2001
From: Starwey <moonbite233@gmail.com>
Date: Sun, 20 Sep 2026 10:12:23 +0800
Subject: [PATCH] board: add Aura USB CDC ACM console

---
 ...MMC-RK801-Luckfox_Aura-Teleop-Buildroot.mk | 14 ++++++-----
 overlay/overlay-luckfox-teleop/etc/inittab    | 24 +++++++++++++++++++
 2 files changed, 32 insertions(+), 6 deletions(-)
 create mode 100644 overlay/overlay-luckfox-teleop/etc/inittab

diff --git a/BoardConfig-EMMC-RK801-Luckfox_Aura-Teleop-Buildroot.mk b/BoardConfig-EMMC-RK801-Luckfox_Aura-Teleop-Buildroot.mk
index 39cde9a..2234289 100644
--- a/BoardConfig-EMMC-RK801-Luckfox_Aura-Teleop-Buildroot.mk
+++ b/BoardConfig-EMMC-RK801-Luckfox_Aura-Teleop-Buildroot.mk
@@ -9,12 +9,14 @@ export RK_KERNEL_DEFCONFIG_FRAGMENT=rv1126b_teleop_low_latency.config
 # Rockchip's rk_dma_heap_cma boot argument is generated from this value.
 export RK_BOOTARGS_CMA_SIZE="256M"
 
+# Retain the physical UART console and mirror post-gadget kernel messages to
+# the USB CDC ACM console exposed by the USB3 OTG Type-C port.
+export RK_ENABLE_USB_GADGET_CONSOLE=y
+
 # This development image has camera/network diagnostics and GStreamer.
 export RK_BUILDROOT_DEFCONFIG=luckfox_64bit_teleop_defconfig
 
-# Keep the vendor overlay path as a single value: the vendor build script's
-# configuration presence check does not handle a whitespace-separated list.
-export RK_POST_OVERLAY="overlay-luckfox-buildroot-64bit"
-# Add project-owned teleop files after OEM preparation, including the static
-# direct-link Ethernet profile.
-export RK_POST_BUILD_SCRIPT="rk-teleop-post-build.sh"
+# Apply teleop files after the vendor base overlay so files such as inittab
+# can intentionally override vendor defaults.
+export RK_POST_OVERLAY="overlay-luckfox-buildroot-64bit overlay-luckfox-teleop"
+unset RK_POST_BUILD_SCRIPT
diff --git a/overlay/overlay-luckfox-teleop/etc/inittab b/overlay/overlay-luckfox-teleop/etc/inittab
new file mode 100644
index 0000000..252e79c
--- /dev/null
+++ b/overlay/overlay-luckfox-teleop/etc/inittab
@@ -0,0 +1,24 @@
+# /etc/inittab
+#
+# BusyBox init does not implement runlevels. The runlevels field is ignored.
+
+::sysinit:/bin/mount -t proc proc /proc
+::sysinit:/bin/mkdir -p /dev/pts /dev/shm
+::sysinit:/bin/mount -a
+::sysinit:/bin/mkdir -p /run/lock/subsys
+::sysinit:/sbin/swapon -a
+null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
+null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
+null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
+null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
+::sysinit:/bin/hostname -F /etc/hostname
+::sysinit:/etc/init.d/rcS
+
+# The physical debug UART remains /dev/console. g_serial creates ttyGS0,
+# which appears as ttyACM* on the CachyOS host after the USB gadget starts.
+console::respawn:/sbin/getty -L console 0 vt100
+ttyGS0::respawn:/sbin/getty -L ttyGS0 115200 vt100
+
+::shutdown:/etc/init.d/rcK
+::shutdown:/sbin/swapoff -a
+::shutdown:/bin/umount -a -r
-- 
