From 31992a6ab2a5387f718e33653df56fd3df2e3f38 Mon Sep 17 00:00:00 2001
From: Starwey <moonbite233@gmail.com>
Date: Sun, 20 Sep 2026 10:28:03 +0800
Subject: [PATCH] Revert "build: append board-specific kernel bootargs"

This reverts commit 531d99c9a304def8aa5cd8d545cfb28dd67c133d.
---
 build.sh | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/build.sh b/build.sh
index f7b1e84..e3584c4 100755
--- a/build.sh
+++ b/build.sh
@@ -131,7 +131,7 @@ function finish_build(){
 function check_config(){
 	unset missing
 	for var in $@; do
-		[ -n "${!var}" ] && continue
+		eval [ \$$var ] && continue
 
 		missing="$missing $var"
 	done
@@ -2643,9 +2643,6 @@ __GET_BOOTARGS_FROM_BOARD_CFG()
 	if [ -n "$RK_BOOTARGS_CMA_SIZE" ]; then
 		SYS_BOOTARGS="$SYS_BOOTARGS rk_dma_heap_cma=$RK_BOOTARGS_CMA_SIZE"
 	fi
-	if [ "$RK_ENABLE_USB_GADGET_CONSOLE" = "y" ]; then
-		SYS_BOOTARGS="$SYS_BOOTARGS console=ttyGS0,115200"
-	fi
 }
 
 function __PREPARE_BOARD_CFG()
-- 
2.55.0

