From 2be19a1129406380b4f57f6de4e8e872b0d2e1f6 Mon Sep 17 00:00:00 2001
From: Starwey <moonbite233@gmail.com>
Date: Sat, 19 Sep 2026 12:29:55 +0800
Subject: [PATCH] buildroot: add Aura teleop development defconfig

---
 Makefile                                      |   2 +
 .../buildroot/luckfox_64bit_teleop_defconfig  | 125 ++++++++++++++++++
 2 files changed, 127 insertions(+)
 create mode 100755 tools/board/buildroot/luckfox_64bit_teleop_defconfig

diff --git a/Makefile b/Makefile
index d8c64a2..ca3801c 100644
--- a/Makefile
+++ b/Makefile
@@ -654,6 +654,7 @@ buildroot_create:
 	tar xzf $(SYSDRV_DIR)/tools/board/buildroot/$(BUILDROOT_VER).tar.gz -C $(BUILDROOT_DIR)
 	cp $(SYSDRV_DIR)/tools/board/buildroot/luckfox_defconfig $(BUILDROOT_DIR)/$(BUILDROOT_VER)/configs/
 	cp $(SYSDRV_DIR)/tools/board/buildroot/luckfox_64bit_defconfig $(BUILDROOT_DIR)/$(BUILDROOT_VER)/configs/
+	cp $(SYSDRV_DIR)/tools/board/buildroot/luckfox_64bit_teleop_defconfig $(BUILDROOT_DIR)/$(BUILDROOT_VER)/configs/
 
 buildroot: prepare
 	@echo -e "$(C_GREEN) ==sysdrv== build buildroot   $(C_NORMAL)"
@@ -662,6 +663,7 @@ buildroot: prepare
 		tar xzf $(SYSDRV_DIR)/tools/board/buildroot/$(BUILDROOT_VER).tar.gz -C $(BUILDROOT_DIR) ;\
 		cp $(SYSDRV_DIR)/tools/board/buildroot/luckfox_defconfig $(BUILDROOT_DIR)/$(BUILDROOT_VER)/configs/ ;\
 		cp $(SYSDRV_DIR)/tools/board/buildroot/luckfox_64bit_defconfig $(BUILDROOT_DIR)/$(BUILDROOT_VER)/configs/ ;\
+		cp $(SYSDRV_DIR)/tools/board/buildroot/luckfox_64bit_teleop_defconfig $(BUILDROOT_DIR)/$(BUILDROOT_VER)/configs/ ;\
 	);
 
 	$(MAKE) ARCH=$(BUILDROOT_ARCH) CROSS_COMPILE=$(CROSS_COMPILE) $(BUILDROOT_DEFCONFIG) -C $(BUILDROOT_DIR)/$(BUILDROOT_VER)
diff --git a/tools/board/buildroot/luckfox_64bit_teleop_defconfig b/tools/board/buildroot/luckfox_64bit_teleop_defconfig
new file mode 100755
index 0000000..a8a07ab
--- /dev/null
+++ b/tools/board/buildroot/luckfox_64bit_teleop_defconfig
@@ -0,0 +1,125 @@
+BR2_aarch64=y
+BR2_KERNEL_HEADERS_6_1=y
+BR2_PACKAGE_GLIBC_KERNEL_COMPAT=y
+# GCC 13 in the vendor Buildroot tree does not select the internal GCC >= 12
+# capability, which makes v4l-utils unavailable. Use GCC 12 for this
+# development image; the vendor GCC 13 defconfig remains unchanged.
+BR2_GCC_VERSION_12_X=y
+BR2_TOOLCHAIN_BUILDROOT_CXX=y
+BR2_PRIMARY_SITE="https://sources.buildroot.net"
+BR2_GNU_MIRROR="https://mirrors.ustc.edu.cn/gnu"
+BR2_TARGET_GENERIC_HOSTNAME="luckfox"
