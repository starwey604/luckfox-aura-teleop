+BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
+BR2_TARGET_GENERIC_ROOT_PASSWD="luckfox"
+BR2_SYSTEM_BIN_SH_BASH=y
+# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
+BR2_ENABLE_LOCALE_WHITELIST="en_US C zh_CN"
