From 9efca4ca6769aa97e13d8492dda0e82b90a50ac2 Mon Sep 17 00:00:00 2001
From: Starwey <moonbite233@gmail.com>
Date: Sun, 20 Sep 2026 10:12:23 +0800
Subject: [PATCH] arm64: configs: enable Aura USB gadget console

---
 arch/arm64/configs/rv1126b_teleop_low_latency.config | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/configs/rv1126b_teleop_low_latency.config b/arch/arm64/configs/rv1126b_teleop_low_latency.config
index 177c734f1..bcd7f82f3 100644
--- a/arch/arm64/configs/rv1126b_teleop_low_latency.config
+++ b/arch/arm64/configs/rv1126b_teleop_low_latency.config
@@ -9,3 +9,8 @@ CONFIG_HZ_1000=y
 
 # CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
 CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
+
+# Expose the USB3 OTG port as a built-in CDC ACM gadget. The serial gadget
+# console becomes ttyGS0 on the board and ttyACM* on a Linux host.
+CONFIG_USB_G_SERIAL=y
+CONFIG_U_SERIAL_CONSOLE=y
-- 
2.55.0

