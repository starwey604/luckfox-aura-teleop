From 5dc8b23f95ca8cd2f60f2a9ececa6e0de50b7f53 Mon Sep 17 00:00:00 2001
From: Starwey <moonbite233@gmail.com>
Date: Sun, 20 Sep 2026 12:23:24 +0800
Subject: [PATCH] media: mia1321: add runtime high-fps tuning

Expose the sensor mode table, PLL dividers and MIPI link frequency as
runtime module parameters so the 100/117 fps RAW10 modes can be brought
up and swept without rebuilding the kernel.

- add a 100 fps RAW10 mode sharing the 117 fps register table (FBDIV 0xc0)
- replace the fixed two-entry link frequency menu with a 576-1248 MHz sweep
- allow overriding PLL OUTDIV/FBDIV/ADC/BITCLK/PCLK/CPCLK in write_array
- select the mode by frame rate (mode_fps) instead of table order
- derive pixel_rate from the effective link frequency
- log the chosen mode, link, pixel rate and FBDIV at stream start

Defaults preserve the previous behaviour (117 fps, 864 MHz, table FBDIV).
---
 drivers/media/i2c/mia1321.c | 299 +++++++++++++++++++++++++++++++-----
 1 file changed, 262 insertions(+), 37 deletions(-)

diff --git a/drivers/media/i2c/mia1321.c b/drivers/media/i2c/mia1321.c
index 31d2f10eb..d329e57b5 100755
--- a/drivers/media/i2c/mia1321.c
+++ b/drivers/media/i2c/mia1321.c
@@ -31,13 +31,64 @@
 
 #define MIA1321_LANES			2
 #define MIA1321_LINK_FREQ_60FPS		576000000
+#define MIA1321_LINK_FREQ_100FPS	768000000
 #define MIA1321_LINK_FREQ_117FPS	864000000
 
-#define MIA1321_PIXEL_RATE_30FPS	192000000
-#define MIA1321_PIXEL_RATE_60FPS	230400000
-#define MIA1321_PIXEL_RATE_117FPS	345600000
 #define MIA1321_XVCLK_FREQ		26000000
 
+/* Sensor PLL registers, individually overridable for high-fps bring-up. */
+#define MIA1321_REG_PLL_OUTDIV		0x004a
+#define MIA1321_REG_PLL_FBDIV		0x004b
+#define MIA1321_REG_PLL_DIV_ADC		0x004c
+#define MIA1321_REG_PLL_DIV_BITCLK	0x004e
+#define MIA1321_REG_PLL_DIV_PCLK	0x0051
+#define MIA1321_REG_PLL_DIV_CPCLK	0x0053
+
+/* Vendor register-table PLL FBDIV values (see the mode register tables). */
+#define MIA1321_FBDIV_30FPS		0x60
+#define MIA1321_FBDIV_60FPS		0x90
+#define MIA1321_FBDIV_100FPS		0xc0
+#define MIA1321_FBDIV_117FPS		0xd8
+
+/*
+ * High-fps bring-up knobs, exposed at
+ * /sys/module/mia1321/parameters/.  All default to 0 (except mode_fps) so a
+ * clean boot behaves exactly like the per-mode register table.
+ */
+static uint mode_fps = 117;
+module_param(mode_fps, uint, 0644);
+MODULE_PARM_DESC(mode_fps,
+	"Preferred MIA1321 mode frame rate (30/60/100/117), default 117");
+
+static uint link_freq_mhz;
+module_param(link_freq_mhz, uint, 0644);
+MODULE_PARM_DESC(link_freq_mhz,
+	"Override MIPI link frequency in MHz; snaps to the nearest menu entry (0 = per-mode default)");
+
+static uint pll_fbdiv;
+module_param(pll_fbdiv, uint, 0644);
+MODULE_PARM_DESC(pll_fbdiv, "Override sensor PLL FBDIV 0x004b (0 = per-mode default)");
+
+static uint pll_outdiv;
+module_param(pll_outdiv, uint, 0644);
+MODULE_PARM_DESC(pll_outdiv, "Override sensor PLL OUTDIV 0x004a (0 = keep table value)");
+
+static uint pll_div_adc;
+module_param(pll_div_adc, uint, 0644);
+MODULE_PARM_DESC(pll_div_adc, "Override sensor PLL DIV_ADC 0x004c (0 = keep table value)");
+
+static uint pll_div_bitclk;
+module_param(pll_div_bitclk, uint, 0644);
+MODULE_PARM_DESC(pll_div_bitclk, "Override sensor PLL DIV_BITCLK 0x004e (0 = keep table value)");
+
+static uint pll_div_pclk;
+module_param(pll_div_pclk, uint, 0644);
+MODULE_PARM_DESC(pll_div_pclk, "Override sensor PLL DIV_PCLK 0x0051 (0 = keep table value)");
+
+static uint pll_div_cpclk;
+module_param(pll_div_cpclk, uint, 0644);
+MODULE_PARM_DESC(pll_div_cpclk, "Override sensor PLL DIV_CPCLK 0x0053 (0 = keep table value)");
+
 #define CHIP_ID				0x0400
 #define MIA1321_REG_CHIP_ID		0x0011
 
@@ -123,8 +174,8 @@ struct mia1321_mode {
 	u32 vts_def;
 	u32 exp_def;
 	const struct regval *reg_list;
-	u32 link_freq_idx;
-	u32 pixel_rate;
+	u32 link_freq_hz;
+	u32 pll_fbdiv;
 	u32 hdr_mode;
 	u32 vc[PAD_MAX];
 };
@@ -556,8 +607,13 @@ static const struct regval mia1321_linear_10_1280x720_regs[] = {
 };
 
 
+/*
+ * Aura supplies this sensor with a 26 MHz xvclk.  The 100 and 117 fps entries
+ * share the same RAW10 register table and differ only in PLL FBDIV; the
+ * runtime mode_fps parameter selects between them.  60 fps is kept as the
+ * validated control mode.
+ */
 static const struct mia1321_mode supported_modes[] = {
-	/* Aura supplies this sensor with a 26 MHz xvclk. */
 	{
 		.width = 1280,
 		.height = 1080,
@@ -570,8 +626,25 @@ static const struct mia1321_mode supported_modes[] = {
 		.vts_def = 0x04b0,
 		.bus_fmt = MEDIA_BUS_FMT_SGRBG10_1X10,
 		.reg_list = mia1321_linear_120_1280x1080_regs,
-		.link_freq_idx = 1,
-		.pixel_rate = MIA1321_PIXEL_RATE_117FPS,
+		.link_freq_hz = MIA1321_LINK_FREQ_117FPS,
+		.pll_fbdiv = MIA1321_FBDIV_117FPS,
+		.hdr_mode = NO_HDR,
+		.vc[PAD0] = 0,
+	},
+	{
+		.width = 1280,
+		.height = 1080,
+		.max_fps = {
+			.numerator = 10000,
+			.denominator = 1000000,
+		},
+		.exp_def = 0x01f4,
+		.hts_def = 0x0a68,
+		.vts_def = 0x04b0,
+		.bus_fmt = MEDIA_BUS_FMT_SGRBG10_1X10,
+		.reg_list = mia1321_linear_120_1280x1080_regs,
+		.link_freq_hz = MIA1321_LINK_FREQ_100FPS,
+		.pll_fbdiv = MIA1321_FBDIV_100FPS,
 		.hdr_mode = NO_HDR,
 		.vc[PAD0] = 0,
 	},
@@ -587,8 +660,8 @@ static const struct mia1321_mode supported_modes[] = {
 		.vts_def = 0x04b0,
 		.bus_fmt = MEDIA_BUS_FMT_SGRBG10_1X10,
 		.reg_list = mia1321_linear_60_1280x1080_regs,
-		.link_freq_idx = 0,
-		.pixel_rate = MIA1321_PIXEL_RATE_60FPS,
+		.link_freq_hz = MIA1321_LINK_FREQ_60FPS,
+		.pll_fbdiv = MIA1321_FBDIV_60FPS,
 		.hdr_mode = NO_HDR,
 		.vc[PAD0] = 0,
 	},
@@ -604,18 +677,90 @@ static const struct mia1321_mode supported_modes[] = {
 		.vts_def = 0x04b0,
 		.bus_fmt = MEDIA_BUS_FMT_SGRBG12_1X12,
 		.reg_list = mia1321_linear_10_1280x720_regs,
-		.link_freq_idx = 0,
-		.pixel_rate = MIA1321_PIXEL_RATE_30FPS,
+		.link_freq_hz = MIA1321_LINK_FREQ_60FPS,
+		.pll_fbdiv = MIA1321_FBDIV_30FPS,
 		.hdr_mode = NO_HDR,
 		.vc[PAD0] = 0,
 	},
 };
 
+/*
+ * Candidate MIPI link frequencies (Hz).  The CSI2 D-PHY derives its data rate
+ * as 2 * link_freq, so the highest entry stays at 2496 Mbps/lane, within the
+ * receiver's 2.5 Gbps capability.  link_freq_mhz snaps to the nearest entry.
+ */
 static const s64 link_freq_menu_items[] = {
-	MIA1321_LINK_FREQ_60FPS,
-	MIA1321_LINK_FREQ_117FPS,
+	576000000, 600000000, 624000000, 648000000, 672000000, 691200000,
+	720000000, 748800000, 768000000, 800000000, 810000000, 832000000,
+	864000000, 900000000, 936000000, 960000000, 1000000000, 1036800000,
+	1080000000, 1123200000, 1152000000, 1200000000, 1248000000,
 };
 
+static u32 mia1321_mode_fps(const struct mia1321_mode *mode)
+{
+	if (!mode->max_fps.numerator)
+		return 0;
+	return mode->max_fps.denominator / mode->max_fps.numerator;
+}
+
+static u32 mia1321_mode_bpp(const struct mia1321_mode *mode)
+{
+	if (mode->bus_fmt == MEDIA_BUS_FMT_SGRBG12_1X12)
+		return 12;
+	return 10;
+}
+
+static const struct mia1321_mode *mia1321_pick_mode(u32 fps)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++)
+		if (mia1321_mode_fps(&supported_modes[i]) == fps)
+			return &supported_modes[i];
+
+	return &supported_modes[0];
+}
+
+static u64 mia1321_effective_link_hz(const struct mia1321_mode *mode)
+{
+	if (link_freq_mhz)
+		return (u64)link_freq_mhz * 1000000ULL;
+	return mode->link_freq_hz;
+}
+
+static u16 mia1321_effective_fbdiv(const struct mia1321_mode *mode)
+{
+	if (pll_fbdiv)
+		return (u16)pll_fbdiv;
+	return (u16)mode->pll_fbdiv;
+}
+
+static u32 mia1321_effective_pixel_rate(const struct mia1321_mode *mode)
+{
+	u64 pixel_rate = 2ULL * mia1321_effective_link_hz(mode) * MIA1321_LANES;
+
+	return (u32)(pixel_rate / mia1321_mode_bpp(mode));
+}
+
+static u32 mia1321_link_freq_to_index(u64 hz)
+{
+	u32 best = 0;
+	u64 best_diff = ~0ULL;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(link_freq_menu_items); i++) {
+		u64 diff = link_freq_menu_items[i] > hz ?
+			link_freq_menu_items[i] - hz : hz - link_freq_menu_items[i];
+
+		if (diff < best_diff) {
+			best_diff = diff;
+			best = i;
+		}
+	}
+
+	return best;
+}
+
 static const char *const mia1321_test_pattern_menu[] = {
 	"Disabled",
 	"Vertical Color Bar Type 1",
@@ -653,18 +798,67 @@ static int mia1321_write_reg(struct i2c_client *client, u16 reg,
 	return 0;
 }
 
+struct mia1321_pll_override {
+	u16 outdiv;
+	u16 fbdiv;
+	u16 div_adc;
+	u16 div_bitclk;
+	u16 div_pclk;
+	u16 div_cpclk;
+};
+
+static u8 mia1321_apply_pll_override(u16 addr, u8 val,
+				     const struct mia1321_pll_override *ov)
+{
+	if (!ov)
+		return val;
+
+	switch (addr) {
+	case MIA1321_REG_PLL_OUTDIV:
+		if (ov->outdiv)
+			val = ov->outdiv;
+		break;
+	case MIA1321_REG_PLL_FBDIV:
+		if (ov->fbdiv)
+			val = ov->fbdiv;
+		break;
+	case MIA1321_REG_PLL_DIV_ADC:
+		if (ov->div_adc)
+			val = ov->div_adc;
+		break;
+	case MIA1321_REG_PLL_DIV_BITCLK:
+		if (ov->div_bitclk)
+			val = ov->div_bitclk;
+		break;
+	case MIA1321_REG_PLL_DIV_PCLK:
+		if (ov->div_pclk)
+			val = ov->div_pclk;
+		break;
+	case MIA1321_REG_PLL_DIV_CPCLK:
+		if (ov->div_cpclk)
+			val = ov->div_cpclk;
+		break;
+	}
+
+	return val;
+}
+
 static int mia1321_write_array(struct i2c_client *client,
-			       const struct regval *regs)
+			       const struct regval *regs,
+			       const struct mia1321_pll_override *ov)
 {
 	u32 i;
 	int ret = 0;
 
 	for (i = 0; ret == 0 && regs[i].addr != REG_NULL; i++) {
+		u8 val = mia1321_apply_pll_override(regs[i].addr,
+						    regs[i].val, ov);
+
 		if (regs[i].addr == REG_DELAY)
-			mdelay(regs[i].val);
+			mdelay(val);
 		else
 			ret = mia1321_write_reg(client, regs[i].addr,
-						MIA1321_REG_VALUE_08BIT, regs[i].val);
+						MIA1321_REG_VALUE_08BIT, val);
 	}
 
 	return ret;
@@ -891,11 +1085,14 @@ mia1321_find_best_fit(struct v4l2_subdev_format *fmt)
 		if (cur_best_fit_dist == -1 || dist < cur_best_fit_dist) {
 			cur_best_fit_dist = dist;
 			cur_best_fit = i;
+		} else if (dist == cur_best_fit_dist &&
+			   mia1321_mode_fps(&supported_modes[i]) == mode_fps) {
+			cur_best_fit = i;
 		}
 	}
 
 	if (cur_best_fit_dist == -1)
-		return &supported_modes[0];
+		return mia1321_pick_mode(mode_fps);
 
 	return &supported_modes[cur_best_fit];
 }
@@ -932,8 +1129,10 @@ static int mia1321_set_fmt(struct v4l2_subdev *sd,
 					 MIA1321_VTS_MAX - mode->height,
 					 1, vblank_def);
 		__v4l2_ctrl_s_ctrl_int64(mia1321->pixel_rate,
-						 mode->pixel_rate);
-		__v4l2_ctrl_s_ctrl(mia1321->link_freq, mode->link_freq_idx);
+					 mia1321_effective_pixel_rate(mode));
+		__v4l2_ctrl_s_ctrl(mia1321->link_freq,
+				   mia1321_link_freq_to_index(
+					   mia1321_effective_link_hz(mode)));
 		mia1321->cur_fps = mode->max_fps;
 	}
 
@@ -1063,6 +1262,7 @@ static long mia1321_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
 	struct mia1321 *mia1321 = to_mia1321(sd);
 	struct rkmodule_hdr_cfg *hdr;
 	u32 i, h, w;
+	int best;
 	long ret = 0;
 	u32 stream = 0;
 
@@ -1079,20 +1279,26 @@ static long mia1321_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
 		hdr = (struct rkmodule_hdr_cfg *)arg;
 		w = mia1321->cur_mode->width;
 		h = mia1321->cur_mode->height;
+		best = -1;
 		for (i = 0; i < ARRAY_SIZE(supported_modes); i++) {
-			if (w == supported_modes[i].width &&
-			    h == supported_modes[i].height &&
-			    supported_modes[i].hdr_mode == hdr->hdr_mode) {
-				mia1321->cur_mode = &supported_modes[i];
+			if (w != supported_modes[i].width ||
+			    h != supported_modes[i].height ||
+			    supported_modes[i].hdr_mode != hdr->hdr_mode)
+				continue;
+			if (best < 0)
+				best = i;
+			if (mia1321_mode_fps(&supported_modes[i]) == mode_fps) {
+				best = i;
 				break;
 			}
 		}
-		if (i == ARRAY_SIZE(supported_modes)) {
+		if (best < 0) {
 			dev_err(&mia1321->client->dev,
 				"not find hdr mode:%d %dx%d config\n",
 				hdr->hdr_mode, w, h);
 			ret = -EINVAL;
 		} else {
+			mia1321->cur_mode = &supported_modes[best];
 			w = mia1321->cur_mode->hts_def - mia1321->cur_mode->width;
 			h = mia1321->cur_mode->vts_def - mia1321->cur_mode->height;
 			__v4l2_ctrl_modify_range(mia1321->hblank, w, w, 1, w);
@@ -1207,10 +1413,24 @@ static long mia1321_compat_ioctl32(struct v4l2_subdev *sd,
 
 static int __mia1321_start_stream(struct mia1321 *mia1321)
 {
+	const struct mia1321_mode *mode = mia1321->cur_mode;
+	struct mia1321_pll_override ov = {
+		.outdiv = pll_outdiv,
+		.fbdiv = mia1321_effective_fbdiv(mode),
+		.div_adc = pll_div_adc,
+		.div_bitclk = pll_div_bitclk,
+		.div_pclk = pll_div_pclk,
+		.div_cpclk = pll_div_cpclk,
+	};
 	int ret;
 
 	if (!mia1321->is_thunderboot) {
-		ret = mia1321_write_array(mia1321->client, mia1321->cur_mode->reg_list);
+		dev_info(&mia1321->client->dev,
+			 "start stream: %ux%u@%u fps, link %llu Hz, pixel %u, fbdiv 0x%02x\n",
+			 mode->width, mode->height, mia1321_mode_fps(mode),
+			 mia1321_effective_link_hz(mode),
+			 mia1321_effective_pixel_rate(mode), ov.fbdiv);
+		ret = mia1321_write_array(mia1321->client, mode->reg_list, &ov);
 		if (ret)
 			return ret;
 
@@ -1303,7 +1523,8 @@ static int mia1321_s_power(struct v4l2_subdev *sd, int on)
 		}
 
 		if (!mia1321->is_thunderboot) {
-			ret = mia1321_write_array(mia1321->client, mia1321_global_regs);
+			ret = mia1321_write_array(mia1321->client,
+						  mia1321_global_regs, NULL);
 			if (ret) {
 				v4l2_err(sd, "could not set init registers\n");
 				pm_runtime_put_noidle(&client->dev);
@@ -1642,18 +1863,19 @@ static int mia1321_initialize_controls(struct mia1321 *mia1321)
 		return ret;
 	handler->lock = &mia1321->mutex;
 
-	mia1321->link_freq = v4l2_ctrl_new_int_menu(handler, NULL,
-						     V4L2_CID_LINK_FREQ,
-						     ARRAY_SIZE(link_freq_menu_items) - 1,
-						     mode->link_freq_idx,
-						     link_freq_menu_items);
+	mia1321->link_freq = v4l2_ctrl_new_int_menu(
+		handler, NULL, V4L2_CID_LINK_FREQ,
+		ARRAY_SIZE(link_freq_menu_items) - 1,
+		mia1321_link_freq_to_index(mia1321_effective_link_hz(mode)),
+		link_freq_menu_items);
 	if (mia1321->link_freq)
 		mia1321->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
 
-	mia1321->pixel_rate = v4l2_ctrl_new_std(handler, NULL,
-						   V4L2_CID_PIXEL_RATE, 0,
-						   MIA1321_PIXEL_RATE_117FPS, 1,
-						   mode->pixel_rate);
+	mia1321->pixel_rate = v4l2_ctrl_new_std(
+		handler, NULL, V4L2_CID_PIXEL_RATE, 0,
+		2ULL * link_freq_menu_items[ARRAY_SIZE(link_freq_menu_items) - 1] *
+			MIA1321_LANES / 10,
+		1, mia1321_effective_pixel_rate(mode));
 
 	h_blank = mode->hts_def - mode->width;
 	mia1321->hblank = v4l2_ctrl_new_std(handler, NULL, V4L2_CID_HBLANK,
@@ -1771,7 +1993,10 @@ static int mia1321_probe(struct i2c_client *client,
 
 	mia1321->is_thunderboot = IS_ENABLED(CONFIG_VIDEO_ROCKCHIP_THUNDER_BOOT_ISP);
 	mia1321->client = client;
-	mia1321->cur_mode = &supported_modes[0];
+	mia1321->cur_mode = mia1321_pick_mode(mode_fps);
+	dev_info(dev, "preferred mode: %ux%u@%u fps\n",
+		 mia1321->cur_mode->width, mia1321->cur_mode->height,
+		 mia1321_mode_fps(mia1321->cur_mode));
 
 	mia1321->xvclk = devm_clk_get(dev, "xvclk");
 	if (IS_ERR(mia1321->xvclk)) {
