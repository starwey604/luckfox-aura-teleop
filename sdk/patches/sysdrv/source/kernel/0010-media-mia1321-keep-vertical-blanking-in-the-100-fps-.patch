From 3432462fa6348ab8c944dfa19ca1d52833f571f3 Mon Sep 17 00:00:00 2001
From: Starwey <moonbite233@gmail.com>
Date: Sun, 20 Sep 2026 14:43:36 +0800
Subject: [PATCH] media: mia1321: keep vertical blanking in the 100 fps mode

Trimming the vertical blanking (0x00d0/0x00d1) starved the online ISP and
caused intermittent rkcif "size err" stalls on long streams.  Only trim
the horizontal total instead: col_n=0x3a (570) keeps the vendor vertical
blanking and gives a stable 100.3 fps over repeated 8000-frame captures.
---
 drivers/media/i2c/mia1321.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/mia1321.c b/drivers/media/i2c/mia1321.c
index d04141485..f1bf02211 100755
--- a/drivers/media/i2c/mia1321.c
+++ b/drivers/media/i2c/mia1321.c
@@ -668,7 +668,12 @@ static const struct mia1321_mode supported_modes[] = {
 		.link_freq_hz = MIA1321_LINK_FREQ_HIGHFPS,
 		.pll_fbdiv = MIA1321_FBDIV_HIGHFPS,
 		.pll_outdiv = MIA1321_PLL_OUTDIV_HIGHFPS,
-		.regs = "0x01c9:0x58,0x01ca:0x02,0x00d0:0x08,0x00d1:0x00",
+		/*
+		 * Trim only the oversized horizontal total.  Do not shorten the
+		 * vertical blanking: the online ISP needs it, and trimming
+		 * 0x00d0/0x00d1 causes intermittent rkcif "size err" stalls.
+		 */
+		.regs = "0x01c9:0x3a,0x01ca:0x02",
 		.hdr_mode = NO_HDR,
 		.vc[PAD0] = 0,
 	},
-- 
