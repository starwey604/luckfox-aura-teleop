From 6a47fe1f4a41780b08e3157fdfd38d1b1275920a Mon Sep 17 00:00:00 2001
From: Starwey <moonbite233@gmail.com>
Date: Sun, 11 Oct 2026 14:30:09 +0800
Subject: [PATCH] media: i2c: add preliminary AR0234 Rockchip port

---
 .../configs/rv1126b_teleop_low_latency.config |    3 +
 drivers/media/i2c/Kconfig                     |   11 +
 drivers/media/i2c/Makefile                    |    1 +
 drivers/media/i2c/ar0234.c                    | 1366 +++++++++++++++++
 4 files changed, 1381 insertions(+)
 create mode 100644 drivers/media/i2c/ar0234.c

diff --git a/arch/arm64/configs/rv1126b_teleop_low_latency.config b/arch/arm64/configs/rv1126b_teleop_low_latency.config
index 177c734f1..367e349db 100644
--- a/arch/arm64/configs/rv1126b_teleop_low_latency.config
+++ b/arch/arm64/configs/rv1126b_teleop_low_latency.config
@@ -9,3 +9,6 @@ CONFIG_HZ_1000=y
 
 # CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
 CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
+
+# Compile the experimental AR0234 port; no camera DT node is enabled yet.
+CONFIG_VIDEO_AR0234=y
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 641b5f573..d21d74d1d 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -960,6 +960,17 @@ config VIDEO_MIS4001
 	  This is a Video4Linux2 sensor driver for the ImageDesign
 	  MIS4001 camera.
 
+config VIDEO_AR0234
+	tristate "onsemi AR0234 sensor support (Rockchip port)"
+	depends on I2C && VIDEO_DEV
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	help
+	  V4L2 sensor driver for the onsemi AR0234/AR0234CS global shutter
+	  sensor. Supports 2/4-lane CSI-2 with 24 MHz input clock and RAW8/10.
+	  Module-specific power, reset and clock wiring must be verified.
+
 config VIDEO_MIA1321
 	tristate "ImageDesign mia1321 sensor support"
 	depends on I2C && VIDEO_DEV
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 4ca52e0fe..9c5a53d0e 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -138,6 +138,7 @@ obj-$(CONFIG_VIDEO_MAX96756) += max96756.o
 obj-$(CONFIG_VIDEO_MIS2031) += mis2031.o
 obj-$(CONFIG_VIDEO_MIS4001) += mis4001.o
 obj-$(CONFIG_VIDEO_MIA1321) += mia1321.o
+obj-$(CONFIG_VIDEO_AR0234) += ar0234.o
 obj-$(CONFIG_VIDEO_ML86V7667) += ml86v7667.o
 obj-$(CONFIG_VIDEO_MSP3400) += msp3400.o
 obj-$(CONFIG_VIDEO_MT9M001) += mt9m001.o
diff --git a/drivers/media/i2c/ar0234.c b/drivers/media/i2c/ar0234.c
new file mode 100644
index 000000000..5fc3e6877
--- /dev/null
+++ b/drivers/media/i2c/ar0234.c
@@ -0,0 +1,1366 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A V4L2 driver for onsemi AR0234 cameras.
+ *
+ * Copyright (C) 2021, Raspberry Pi (Trading) Ltd
+ * Copyright (C) 2025-2026, UAB Kurokesu
+ *
+ * Rockchip Linux 6.1 port: register tables from Kurokesu commit
+ * eefdf9c42cb8f06f7cf00a18b08c7c23d9363a9f; subdevice integration follows
+ * the Rockchip MIA1321 driver (Copyright 2023 Rockchip Electronics Co., Ltd.).
+ * Module-specific electrical parameters require hardware validation.
+ *
+ * Based on Sony imx219 camera driver
+ * Copyright (C) 2019, Raspberry Pi (Trading) Ltd
+ *
+ */
+
+#include <linux/clk.h>
+#include <linux/compat.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/rk-camera-module.h>
+#include <linux/uaccess.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/* Encode value width beside the 16-bit I2C register address. */
+#define AR0234_REG8(addr) ((1U << 16) | (addr))
+#define AR0234_REG16(addr) ((2U << 16) | (addr))
+
+struct ar0234_regval {
+	u32 reg;
+	u16 val;
+};
+
+/* Registers */
+#define AR0234_REG_CHIP_ID AR0234_REG16(0x3000)
+#define AR0234_REG_Y_ADDR_START AR0234_REG16(0x3002)
+#define AR0234_REG_X_ADDR_START AR0234_REG16(0x3004)
+#define AR0234_REG_Y_ADDR_END AR0234_REG16(0x3006)
+#define AR0234_REG_X_ADDR_END AR0234_REG16(0x3008)
+#define AR0234_REG_LINE_LENGTH_PCK AR0234_REG16(0x300C)
+#define AR0234_REG_FRAME_LENGTH_LINES AR0234_REG16(0x300A)
+#define AR0234_REG_EXPOSURE_COARSE AR0234_REG16(0x3012)
+#define AR0234_REG_RESET AR0234_REG16(0x301A)
+#define AR0234_REG_MODE_SELECT AR0234_REG8(0x301C)
+#define AR0234_REG_IMAGE_ORIENTATION AR0234_REG8(0x301D)
+#define AR0234_REG_GROUPED_PARAMETER_HOLD AR0234_REG8(0x3022)
+#define AR0234_REG_VT_PIX_CLK_DIV AR0234_REG16(0x302A)
+#define AR0234_REG_VT_SYS_CLK_DIV AR0234_REG16(0x302C)
+#define AR0234_REG_PRE_PLL_CLK_DIV AR0234_REG16(0x302E)
+#define AR0234_REG_PLL_MULTIPLIER AR0234_REG16(0x3030)
+#define AR0234_REG_OP_PIX_CLK_DIV AR0234_REG16(0x3036)
+#define AR0234_REG_OP_SYS_CLK_DIV AR0234_REG16(0x3038)
+#define AR0234_REG_READ_MODE AR0234_REG16(0x3040)
+#define AR0234_REG_DIGITAL_GAIN AR0234_REG16(0x305E)
+#define AR0234_REG_ANALOG_GAIN AR0234_REG16(0x3060)
+#define AR0234_REG_SMIA_TEST AR0234_REG16(0x3064)
+#define AR0234_REG_DATAPATH_SELECT AR0234_REG16(0x306E)
+#define AR0234_REG_TEST_PATTERN_MODE AR0234_REG16(0x3070)
+#define AR0234_REG_TEST_DATA_RED AR0234_REG16(0x3072)
+#define AR0234_REG_TEST_DATA_GREENR AR0234_REG16(0x3074)
+#define AR0234_REG_TEST_DATA_BLUE AR0234_REG16(0x3076)
+#define AR0234_REG_TEST_DATA_GREENB AR0234_REG16(0x3078)
+#define AR0234_REG_OPERATION_MODE_CTRL AR0234_REG16(0x3082)
+#define AR0234_REG_SEQ_DATA_PORT AR0234_REG16(0x3086)
+#define AR0234_REG_SEQ_CTRL_PORT AR0234_REG16(0x3088)
+#define AR0234_REG_X_ODD_INC AR0234_REG16(0x30A2)
+#define AR0234_REG_Y_ODD_INC AR0234_REG16(0x30A6)
+#define AR0234_REG_DIGITAL_TEST AR0234_REG16(0x30B0)
+#define AR0234_REG_TEMPSENS_CTRL AR0234_REG16(0x30B4)
+#define AR0234_REG_MFR_30BA AR0234_REG16(0x30BA)
+#define AR0234_REG_GRR_CONTROL1 AR0234_REG16(0x30CE)
+#define AR0234_REG_AE_LUMA_TARGET AR0234_REG16(0x3102)
+#define AR0234_REG_DELTA_DK_CONTROL AR0234_REG16(0x3180)
+#define AR0234_REG_DATA_FORMAT_BITS AR0234_REG16(0x31AC)
+#define AR0234_REG_SERIAL_FORMAT AR0234_REG16(0x31AE)
+#define AR0234_REG_FRAME_PREAMBLE AR0234_REG16(0x31B0)
+#define AR0234_REG_LINE_PREAMBLE AR0234_REG16(0x31B2)
+#define AR0234_REG_MIPI_TIMING_0 AR0234_REG16(0x31B4)
+#define AR0234_REG_MIPI_TIMING_1 AR0234_REG16(0x31B6)
+#define AR0234_REG_MIPI_TIMING_2 AR0234_REG16(0x31B8)
+#define AR0234_REG_MIPI_TIMING_3 AR0234_REG16(0x31BA)
+#define AR0234_REG_MIPI_TIMING_4 AR0234_REG16(0x31BC)
+#define AR0234_REG_COMPANDING AR0234_REG16(0x31D0)
+#define AR0234_REG_PIX_DEF_ID AR0234_REG16(0x31E0)
+#define AR0234_REG_LED_FLASH_CONTROL AR0234_REG16(0x3270)
+#define AR0234_REG_MIPI_CNTRL AR0234_REG16(0x3354)
+
+/* Chip ID */
+#define AR0234_CHIP_ID 0x0A56
+#define AR0234_CHIP_ID_MONO 0x1A56
+
+/* Sensor frequencies */
+#define AR0234_FREQ_EXTCLK 24000000
+#define AR0234_FREQ_PIXCLK_45MHZ 45000000
+#define AR0234_FREQ_PIXCLK_90MHZ 90000000
+
+/*
+ * AR0234 uses different link frequencies depending on
+ * output bit depth. 360 MHz for 8-bit, 450 MHz for 10-bit.
+ */
+#define AR0234_FREQ_LINK_8BIT 360000000
+#define AR0234_FREQ_LINK_10BIT 450000000
+
+/* Frame timing */
+#define AR0234_FLL_OVERHEAD 5
+#define AR0234_FLL_MAX (0xFFFF + AR0234_FLL_OVERHEAD)
+#define AR0234_VBLANK_MIN (16 + AR0234_FLL_OVERHEAD)
+#define AR0234_LINE_LENGTH_PCK_DEF 612
+
+/* AR0234_REG_RESET Bits */
+#define AR0234_RESET_DEFAULT 0x2058
+#define AR0234_RESET_STREAM BIT(2)
+#define AR0234_RESET_GPI_EN BIT(8)
+#define AR0234_RESET_FORCED_PLL_ON BIT(11)
+
+/* AR0234_REG_GRR_CONTROL1 Bits */
+#define AR0234_GRR_SLAVE_SH_SYNC BIT(8)
+
+/* AR0234_REG_LED_FLASH_CONTROL Bits */
+#define AR0234_FLASH_ENABLE BIT(8)
+
+/* Exposure control */
+#define AR0234_EXPOSURE_MIN 2
+#define AR0234_EXPOSURE_STEP 1
+
+/* Analog gain control */
+#define AR0234_ANA_GAIN_MIN 0x0D
+#define AR0234_ANA_GAIN_MAX 0x40
+#define AR0234_ANA_GAIN_STEP 1
+#define AR0234_ANA_GAIN_DEFAULT 0x0E
+#define AR0234_MFR_30BA_GAIN_BITS(_val) (0x7620 | (_val))
+#define AR0234_MFR_30BA_DEFAULT AR0234_MFR_30BA_GAIN_BITS(2)
+
+/* Digital gain control */
+#define AR0234_DGTL_GAIN_MIN 0x0080
+#define AR0234_DGTL_GAIN_MAX 0x07FF
+#define AR0234_DGTL_GAIN_DEFAULT 0x0080
+#define AR0234_DGTL_GAIN_STEP 1
+
+/* Test Patterns */
+#define AR0234_TEST_PATTERN_COLOR_MIN 0
+#define AR0234_TEST_PATTERN_COLOR_MAX 0x03FF
+#define AR0234_TEST_PATTERN_COLOR_STEP 1
+
+#define AR0234_TEST_PATTERN_DISABLED 0
+#define AR0234_TEST_PATTERN_SOLID_COLOR 1
+#define AR0234_TEST_PATTERN_COLOR_BARS 2
+#define AR0234_TEST_PATTERN_FADE_TO_GREY 3
+#define AR0234_TEST_PATTERN_WALKING_1S 256
+
+#define AR0234_NATIVE_WIDTH 1940U
+#define AR0234_NATIVE_HEIGHT 1220U
+#define AR0234_PIXEL_ARRAY_LEFT 8U
+#define AR0234_PIXEL_ARRAY_TOP 8U
+#define AR0234_PIXEL_ARRAY_WIDTH 1920U
+#define AR0234_PIXEL_ARRAY_HEIGHT 1200U
+
+#define AR0234_NUM_SUPPLIES ARRAY_SIZE(ar0234_supply_names)
+
+struct ar0234_reg_sequence {
+	unsigned int num_regs;
+	const struct ar0234_regval *regs;
+};
+
+enum ar0234_lane_count_id {
+	AR0234_LANE_COUNT_ID_2LANE = 0,
+	AR0234_LANE_COUNT_ID_4LANE,
+};
+
+/* Sensor mode: resolution, crop and register sequence */
+struct ar0234_mode {
+	/* Frame width */
+	unsigned int width;
+	/* Frame height */
+	unsigned int height;
+	/* Analog crop rectangle. */
+	struct v4l2_rect crop;
+
+	struct ar0234_reg_sequence reg_sequence;
+};
+
+/*
+ * PLL config for:
+ * External clock - 24MHz
+ * Link frequency - 360MHz
+ * Bit depth      - 8bit
+ */
+static const struct ar0234_regval ar0234_pll_config_24_360_8bit[] = {
+	{ AR0234_REG_VT_PIX_CLK_DIV, 0x0008 },
+	{ AR0234_REG_VT_SYS_CLK_DIV, 0x0001 },
+	{ AR0234_REG_PRE_PLL_CLK_DIV, 0x0001 },
+	{ AR0234_REG_PLL_MULTIPLIER, 0x001E },
+	{ AR0234_REG_OP_PIX_CLK_DIV, 0x0008 },
+	{ AR0234_REG_OP_SYS_CLK_DIV, 0x0002 },
+	{ AR0234_REG_FRAME_PREAMBLE, 0x0080 },
+	{ AR0234_REG_LINE_PREAMBLE, 0x005C },
+	{ AR0234_REG_MIPI_TIMING_0, 0x5248 },
+	{ AR0234_REG_MIPI_TIMING_1, 0x4258 },
+	{ AR0234_REG_MIPI_TIMING_2, 0x904C },
+	{ AR0234_REG_MIPI_TIMING_3, 0x028B },
+	{ AR0234_REG_MIPI_TIMING_4, 0x0D89 },
+	{ AR0234_REG_MIPI_CNTRL, 0x002A },
+	{ AR0234_REG_DATA_FORMAT_BITS, 0x0808 }, /* 8-bit in/out */
+};
+
+/*
+ * PLL config for:
+ * External clock - 24MHz
+ * Link frequency - 450MHz
+ * Bit depth      - 10bit
+ */
+static const struct ar0234_regval ar0234_pll_config_24_450_10bit[] = {
+	{ AR0234_REG_VT_PIX_CLK_DIV, 0x0005 },
+	{ AR0234_REG_VT_SYS_CLK_DIV, 0x0001 },
+	{ AR0234_REG_PRE_PLL_CLK_DIV, 0x0008 },
+	{ AR0234_REG_PLL_MULTIPLIER, 0x0096 },
+	{ AR0234_REG_OP_PIX_CLK_DIV, 0x000A },
+	{ AR0234_REG_OP_SYS_CLK_DIV, 0x0001 },
+	{ AR0234_REG_FRAME_PREAMBLE, 0x0082 },
+	{ AR0234_REG_LINE_PREAMBLE, 0x005C },
+	{ AR0234_REG_MIPI_TIMING_0, 0x4248 },
+	{ AR0234_REG_MIPI_TIMING_1, 0x4258 },
+	{ AR0234_REG_MIPI_TIMING_2, 0x904B },
+	{ AR0234_REG_MIPI_TIMING_3, 0x030B },
+	{ AR0234_REG_MIPI_TIMING_4, 0x0D89 },
+	{ AR0234_REG_MIPI_CNTRL, 0x002B },
+	{ AR0234_REG_DATA_FORMAT_BITS, 0x0A0A }, /* 10-bit in/out */
+};
+
+static const struct ar0234_regval common_init[] = {
+	{ AR0234_REG_DIGITAL_TEST, 0x0028 },
+	{ AR0234_REG_DATAPATH_SELECT, 0x9010 },
+	{ AR0234_REG_OPERATION_MODE_CTRL, 0x0003 },
+	{ AR0234_REG_COMPANDING, 0x0000 },
+	{ AR0234_REG_SEQ_CTRL_PORT, 0x8050 },
+	{ AR0234_REG_SEQ_DATA_PORT, 0x9237 },
+	{ AR0234_REG16(0x3096), 0x0280 },
+	{ AR0234_REG_PIX_DEF_ID, 0x0003 },
+	{ AR0234_REG16(0x3F4C), 0x121F },
+	{ AR0234_REG16(0x3F4E), 0x121F },
+	{ AR0234_REG16(0x3F50), 0x0B81 },
+	{ AR0234_REG16(0x3ED2), 0xFA96 },
+	{ AR0234_REG_DELTA_DK_CONTROL, 0x824F },
+	{ AR0234_REG16(0x3ECC), 0x0C42 },
+	{ AR0234_REG16(0x3ECC), 0x0C42 },
+	{ AR0234_REG16(0x30F0), 0x2283 },
+	{ AR0234_REG_AE_LUMA_TARGET, 0x5000 },
+	{ AR0234_REG_TEMPSENS_CTRL, 0x0011 },
+	{ AR0234_REG_SMIA_TEST, 0x1802 },
+};
+
+/* Recommended manufacturer settings for 45MHz pixel clock */
+static const struct ar0234_regval pixclk_45mhz_mfr_settings[] = {
+	{ AR0234_REG_SEQ_CTRL_PORT, 0x81BA },
+	{ AR0234_REG_SEQ_DATA_PORT, 0x3D02 },
+};
+
+/* Full sensor resolution */
+static const struct ar0234_regval ar0234_1920x1200_config[] = {
+	{ AR0234_REG_Y_ADDR_START, 0x0008 },
+	{ AR0234_REG_X_ADDR_START, 0x0008 },
+	{ AR0234_REG_Y_ADDR_END, 0x04B7 },
+	{ AR0234_REG_X_ADDR_END, 0x0787 },
+	{ AR0234_REG_X_ODD_INC, 0x0001 },
+	{ AR0234_REG_Y_ODD_INC, 0x0001 },
+};
+
+static const struct ar0234_regval ar0234_1080p_config[] = {
+	{ AR0234_REG_Y_ADDR_START, 0x0044 },
+	{ AR0234_REG_X_ADDR_START, 0x0008 },
+	{ AR0234_REG_Y_ADDR_END, 0x047B },
+	{ AR0234_REG_X_ADDR_END, 0x0787 },
+	{ AR0234_REG_X_ODD_INC, 0x0001 },
+	{ AR0234_REG_Y_ODD_INC, 0x0001 },
+};
+
+static const struct ar0234_regval ar0234_720p_config[] = {
+	{ AR0234_REG_Y_ADDR_START, 0x00F8 },
+	{ AR0234_REG_X_ADDR_START, 0x0148 },
+	{ AR0234_REG_Y_ADDR_END, 0x03C7 },
+	{ AR0234_REG_X_ADDR_END, 0x0647 },
+	{ AR0234_REG_X_ODD_INC, 0x0001 },
+	{ AR0234_REG_Y_ODD_INC, 0x0001 },
+};
+
+/* Binned 2x2 */
+static const struct ar0234_regval ar0234_960x600_config[] = {
+	{ AR0234_REG_Y_ADDR_START, 0x0008 },
+	{ AR0234_REG_X_ADDR_START, 0x0008 },
+	{ AR0234_REG_Y_ADDR_END, 0x04B7 },
+	{ AR0234_REG_X_ADDR_END, 0x0787 },
+	{ AR0234_REG_X_ODD_INC, 0x0003 },
+	{ AR0234_REG_Y_ODD_INC, 0x0003 },
+	{ AR0234_REG_READ_MODE, 0x3000 },
+};
+
+static const char *const ar0234_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Color",
+	"Vertical Color Bars",
+	"Fade to Grey Color Bars",
+	"Walking 1s",
+};
+
+static const unsigned int ar0234_test_pattern_val[] = {
+	AR0234_TEST_PATTERN_DISABLED, /* Disabled */
+	AR0234_TEST_PATTERN_SOLID_COLOR, /* Solid Color */
+	AR0234_TEST_PATTERN_COLOR_BARS, /* Vertical Color Bars */
+	AR0234_TEST_PATTERN_FADE_TO_GREY, /* Fade to Grey Color Bars */
+	AR0234_TEST_PATTERN_WALKING_1S, /* Walking 1s */
+};
+
+/* regulator supplies */
+static const char *const ar0234_supply_names[] = {
+	/* Rockchip BSP names; voltages are described by the module's DT. */
+	"avdd",
+	"dovdd",
+	"dvdd",
+};
+
+/* Format configs */
+static const struct ar0234_mode ar0234_modes[] = {
+	{
+		.width = 1920,
+		.height = 1200,
+		.crop = {
+			.left = AR0234_PIXEL_ARRAY_LEFT,
+			.top = AR0234_PIXEL_ARRAY_TOP,
+			.width = 1920,
+			.height = 1200,
+		},
+		.reg_sequence = {
+			.regs = ar0234_1920x1200_config,
+			.num_regs = ARRAY_SIZE(ar0234_1920x1200_config),
+		},
+	},
+	{
+		.width = 1920,
+		.height = 1080,
+		.crop = {
+			.left = AR0234_PIXEL_ARRAY_LEFT,
+			.top = AR0234_PIXEL_ARRAY_TOP + 60,
+			.width = 1920,
+			.height = 1080,
+		},
+		.reg_sequence = {
+			.regs = ar0234_1080p_config,
+			.num_regs = ARRAY_SIZE(ar0234_1080p_config),
+		},
+	},
+	{
+		.width = 1280,
+		.height = 720,
+		.crop = {
+			.left = AR0234_PIXEL_ARRAY_LEFT + 320,
+			.top = AR0234_PIXEL_ARRAY_TOP + 240,
+			.width = 1280,
+			.height = 720,
+		},
+		.reg_sequence = {
+			.regs = ar0234_720p_config,
+			.num_regs = ARRAY_SIZE(ar0234_720p_config),
+		},
+	},
+	{
+		.width = 960,
+		.height = 600,
+		.crop = {
+			.left = AR0234_PIXEL_ARRAY_LEFT,
+			.top = AR0234_PIXEL_ARRAY_TOP,
+			.width = 1920,
+			.height = 1200,
+		},
+		.reg_sequence = {
+			.regs = ar0234_960x600_config,
+			.num_regs = ARRAY_SIZE(ar0234_960x600_config),
+		},
+	},
+};
+
+struct ar0234_pll_config {
+	s64 freq_link;
+	u32 freq_extclk;
+	struct ar0234_reg_sequence regs_pll;
+};
+
+static const struct ar0234_pll_config ar0234_pll_configs[] = {
+	{
+		.freq_link = AR0234_FREQ_LINK_8BIT,
+		.freq_extclk = AR0234_FREQ_EXTCLK,
+		.regs_pll = {
+			.regs = ar0234_pll_config_24_360_8bit,
+			.num_regs = ARRAY_SIZE(ar0234_pll_config_24_360_8bit),
+		},
+	},
+	{
+		.freq_link = AR0234_FREQ_LINK_10BIT,
+		.freq_extclk = AR0234_FREQ_EXTCLK,
+		.regs_pll = {
+			.regs = ar0234_pll_config_24_450_10bit,
+			.num_regs = ARRAY_SIZE(ar0234_pll_config_24_450_10bit),
+		},
+	},
+};
+
+/* Pixel clock frequencies are based on lane count */
+static const u32 ar0234_freq_pixclk[] = {
+	[AR0234_LANE_COUNT_ID_2LANE] = AR0234_FREQ_PIXCLK_45MHZ,
+	[AR0234_LANE_COUNT_ID_4LANE] = AR0234_FREQ_PIXCLK_90MHZ,
+};
+
+/* Report nonnegative HBLANK and CSI pixel rate to Rockchip. */
+#define AR0234_TIMING_SCALE 4
+#define AR0234_HTS (AR0234_LINE_LENGTH_PCK_DEF * AR0234_TIMING_SCALE)
+
+struct ar0234 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct clk *xvclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *pwdn_gpio;
+	struct regulator_bulk_data supplies[AR0234_NUM_SUPPLIES];
+	struct v4l2_mbus_config_mipi_csi2 bus;
+	const struct ar0234_pll_config *pll_config;
+	enum ar0234_lane_count_id lane_count_id;
+	const struct ar0234_mode *cur_mode;
+	struct mutex mutex;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	u32 module_index;
+	const char *module_facing;
+	const char *module_name;
+	const char *lens_name;
+	u16 mfr_30ba;
+	bool monochrome;
+	bool streaming;
+	bool power_on;
+};
+
+static inline struct ar0234 *to_ar0234(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ar0234, sd);
+}
+
+static int ar0234_write_reg(struct ar0234 *ar, u32 reg, u16 val)
+{
+	u32 len = reg >> 16;
+	u8 buf[4] = { reg >> 8, reg, val >> 8, val };
+	int ret;
+
+	if (len != 1 && len != 2)
+		return -EINVAL;
+	if (len == 1)
+		buf[2] = val;
+	ret = i2c_master_send(ar->client, buf, len + 2);
+	return ret == len + 2 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static int ar0234_read_reg(struct ar0234 *ar, u32 reg, u16 *val)
+{
+	u32 len = reg >> 16;
+	u8 addr[2] = { reg >> 8, reg };
+	u8 data[2] = { 0 };
+	struct i2c_msg msgs[] = {
+		{ .addr = ar->client->addr, .len = 2, .buf = addr },
+		{ .addr = ar->client->addr, .flags = I2C_M_RD,
+		  .len = len, .buf = data },
+	};
+	int ret;
+
+	if (len != 1 && len != 2)
+		return -EINVAL;
+	ret = i2c_transfer(ar->client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return ret < 0 ? ret : -EIO;
+	*val = len == 2 ? (data[0] << 8) | data[1] : data[0];
+	return 0;
+}
+
+static int ar0234_write_array(struct ar0234 *ar,
+			      const struct ar0234_regval *regs, unsigned int n)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < n; i++) {
+		ret = ar0234_write_reg(ar, regs[i].reg, regs[i].val);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int ar0234_write_sequence(struct ar0234 *ar,
+				 const struct ar0234_reg_sequence *seq)
+{
+	return ar0234_write_array(ar, seq->regs, seq->num_regs);
+}
+
+static u32 ar0234_pixel_rate(struct ar0234 *ar)
+{
+	return ar0234_freq_pixclk[ar->lane_count_id] * AR0234_TIMING_SCALE;
+}
+
+static u32 ar0234_get_format_code(struct ar0234 *ar)
+{
+	static const u32 bayer8[] = {
+		MEDIA_BUS_FMT_SGRBG8_1X8, MEDIA_BUS_FMT_SRGGB8_1X8,
+		MEDIA_BUS_FMT_SBGGR8_1X8, MEDIA_BUS_FMT_SGBRG8_1X8,
+	};
+	static const u32 bayer10[] = {
+		MEDIA_BUS_FMT_SGRBG10_1X10, MEDIA_BUS_FMT_SRGGB10_1X10,
+		MEDIA_BUS_FMT_SBGGR10_1X10, MEDIA_BUS_FMT_SGBRG10_1X10,
+	};
+	bool raw8 = ar->pll_config->freq_link == AR0234_FREQ_LINK_8BIT;
+	u32 index = ar->hflip ? ar->hflip->val | (ar->vflip->val << 1) : 0;
+
+	if (ar->monochrome)
+		return raw8 ? MEDIA_BUS_FMT_Y8_1X8 : MEDIA_BUS_FMT_Y10_1X10;
+	return raw8 ? bayer8[index] : bayer10[index];
+}
+
+static void ar0234_fill_format(struct ar0234 *ar,
+			       const struct ar0234_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	memset(fmt, 0, sizeof(*fmt));
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = ar0234_get_format_code(ar);
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->reserved[0] = 0; /* Rockchip virtual channel 0, linear mode. */
+}
+
+static void ar0234_frame_interval(struct ar0234 *ar,
+				const struct ar0234_mode *mode, u32 vblank,
+				struct v4l2_fract *interval)
+{
+	interval->numerator = AR0234_HTS * (mode->height + vblank);
+	interval->denominator = ar0234_pixel_rate(ar);
+}
+
+static int ar0234_set_analog_gain(struct ar0234 *ar, u32 gain)
+{
+	u16 mfr;
+	int ret, release_ret;
+
+	if (ar->lane_count_id == AR0234_LANE_COUNT_ID_2LANE)
+		mfr = AR0234_MFR_30BA_GAIN_BITS(gain < 0x36 ? 6 : 0);
+	else
+		mfr = AR0234_MFR_30BA_GAIN_BITS(gain < 0x20 ? 2 :
+					       gain < 0x3a ? 1 : 0);
+	if (mfr == ar->mfr_30ba)
+		return ar0234_write_reg(ar, AR0234_REG_ANALOG_GAIN, gain);
+
+	ret = ar0234_write_reg(ar, AR0234_REG_GROUPED_PARAMETER_HOLD, 1);
+	if (ret)
+		return ret;
+	ret = ar0234_write_reg(ar, AR0234_REG_MFR_30BA, mfr);
+	if (!ret)
+		ret = ar0234_write_reg(ar, AR0234_REG_ANALOG_GAIN, gain);
+	/* Always release hold, even if an earlier I2C transfer failed. */
+	release_ret = ar0234_write_reg(ar, AR0234_REG_GROUPED_PARAMETER_HOLD, 0);
+	if (!ret)
+		ret = release_ret;
+	if (!ret)
+		ar->mfr_30ba = mfr;
+	return ret;
+}
+
+static int ar0234_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ar0234 *ar = container_of(ctrl->handler, struct ar0234, ctrl_handler);
+	int max_exp, ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		max_exp = ar->cur_mode->height + ctrl->val - AR0234_FLL_OVERHEAD - 1;
+		__v4l2_ctrl_modify_range(ar->exposure, AR0234_EXPOSURE_MIN,
+					 max_exp, 1, min(max_exp, 100));
+	}
+	ret = pm_runtime_get_if_in_use(ar->dev);
+	if (ret <= 0)
+		return ret < 0 ? ret : 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = ar0234_write_reg(ar, AR0234_REG_EXPOSURE_COARSE, ctrl->val);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = ar0234_set_analog_gain(ar, ctrl->val);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = ar0234_write_reg(ar, AR0234_REG_DIGITAL_GAIN, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = ar0234_write_reg(ar, AR0234_REG_FRAME_LENGTH_LINES,
+				      ar->cur_mode->height + ctrl->val - AR0234_FLL_OVERHEAD);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = ar0234_write_reg(ar, AR0234_REG_IMAGE_ORIENTATION,
+				      ar->hflip->val | (ar->vflip->val << 1));
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = ar0234_write_reg(ar, AR0234_REG_TEST_PATTERN_MODE,
+				      ar0234_test_pattern_val[ctrl->val]);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	pm_runtime_put(ar->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ar0234_ctrl_ops = {
+	.s_ctrl = ar0234_set_ctrl,
+};
+
+static int ar0234_init_controls(struct ar0234 *ar)
+{
+	struct v4l2_ctrl_handler *hdl = &ar->ctrl_handler;
+	const struct ar0234_mode *mode = ar->cur_mode;
+	struct v4l2_ctrl *ctrl;
+	int hblank = AR0234_HTS - mode->width;
+	int max_exp = mode->height + AR0234_VBLANK_MIN - AR0234_FLL_OVERHEAD - 1;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 10);
+	if (ret)
+		return ret;
+	hdl->lock = &ar->mutex;
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      &ar->pll_config->freq_link);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE,
+				 ar0234_pixel_rate(ar), ar0234_pixel_rate(ar), 1,
+				 ar0234_pixel_rate(ar));
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ar->hblank = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK,
+				      hblank, hblank, 1, hblank);
+	if (ar->hblank)
+		ar->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	ar->vblank = v4l2_ctrl_new_std(hdl, &ar0234_ctrl_ops, V4L2_CID_VBLANK,
+				      AR0234_VBLANK_MIN, AR0234_FLL_MAX - mode->height,
+				      1, AR0234_VBLANK_MIN);
+	ar->exposure = v4l2_ctrl_new_std(hdl, &ar0234_ctrl_ops, V4L2_CID_EXPOSURE,
+					AR0234_EXPOSURE_MIN, max_exp, 1, min(max_exp, 100));
+	v4l2_ctrl_new_std(hdl, &ar0234_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			 AR0234_ANA_GAIN_MIN, AR0234_ANA_GAIN_MAX, 1, AR0234_ANA_GAIN_DEFAULT);
+	v4l2_ctrl_new_std(hdl, &ar0234_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			 AR0234_DGTL_GAIN_MIN, AR0234_DGTL_GAIN_MAX, 1, AR0234_DGTL_GAIN_DEFAULT);
+	ar->hflip = v4l2_ctrl_new_std(hdl, &ar0234_ctrl_ops, V4L2_CID_HFLIP, 0, 1, 1, 0);
+	ar->vflip = v4l2_ctrl_new_std(hdl, &ar0234_ctrl_ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (ar->hflip)
+		ar->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	if (ar->vflip)
+		ar->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	v4l2_ctrl_new_std_menu_items(hdl, &ar0234_ctrl_ops, V4L2_CID_TEST_PATTERN,
+				   ARRAY_SIZE(ar0234_test_pattern_menu) - 1, 0, 0,
+				   ar0234_test_pattern_menu);
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+	ar->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int ar0234_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+
+	if (code->pad || code->index)
+		return -EINVAL;
+	mutex_lock(&ar->mutex);
+	code->code = ar0234_get_format_code(ar);
+	mutex_unlock(&ar->mutex);
+	return 0;
+}
+
+static int ar0234_enum_frame_size(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	int ret = 0;
+
+	mutex_lock(&ar->mutex);
+	if (fse->pad || fse->index >= ARRAY_SIZE(ar0234_modes) ||
+	    fse->code != ar0234_get_format_code(ar)) {
+		ret = -EINVAL;
+	} else {
+		fse->min_width = ar0234_modes[fse->index].width;
+		fse->max_width = fse->min_width;
+		fse->min_height = ar0234_modes[fse->index].height;
+		fse->max_height = fse->min_height;
+	}
+	mutex_unlock(&ar->mutex);
+	return ret;
+}
+
+static int ar0234_enum_frame_interval(struct v4l2_subdev *sd,
+				     struct v4l2_subdev_state *state,
+				     struct v4l2_subdev_frame_interval_enum *fie)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	unsigned int i;
+	int ret = -EINVAL;
+
+	mutex_lock(&ar->mutex);
+	if (fie->pad || fie->index || fie->code != ar0234_get_format_code(ar))
+		goto out;
+	for (i = 0; i < ARRAY_SIZE(ar0234_modes); i++) {
+		if (fie->width == ar0234_modes[i].width &&
+		    fie->height == ar0234_modes[i].height) {
+			ar0234_frame_interval(ar, &ar0234_modes[i], AR0234_VBLANK_MIN,
+					     &fie->interval);
+			fie->reserved[0] = NO_HDR;
+			ret = 0;
+			break;
+		}
+	}
+out:
+	mutex_unlock(&ar->mutex);
+	return ret;
+}
+
+static int ar0234_get_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+
+	if (fmt->pad)
+		return -EINVAL;
+	mutex_lock(&ar->mutex);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_get_try_format(sd, state, 0);
+	else
+		ar0234_fill_format(ar, ar->cur_mode, &fmt->format);
+	mutex_unlock(&ar->mutex);
+	return 0;
+}
+
+static int ar0234_set_fmt(struct v4l2_subdev *sd,
+			 struct v4l2_subdev_state *state,
+			 struct v4l2_subdev_format *fmt)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	const struct ar0234_mode *mode;
+	int hblank, ret = 0;
+
+	if (fmt->pad)
+		return -EINVAL;
+	mutex_lock(&ar->mutex);
+	mode = v4l2_find_nearest_size(ar0234_modes, ARRAY_SIZE(ar0234_modes),
+				     width, height, fmt->format.width, fmt->format.height);
+	ar0234_fill_format(ar, mode, &fmt->format);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_get_try_format(sd, state, 0) = fmt->format;
+	} else if (ar->streaming) {
+		ret = -EBUSY;
+	} else {
+		ar->cur_mode = mode;
+		hblank = AR0234_HTS - mode->width;
+		__v4l2_ctrl_modify_range(ar->hblank, hblank, hblank, 1, hblank);
+		__v4l2_ctrl_modify_range(ar->vblank, AR0234_VBLANK_MIN,
+					AR0234_FLL_MAX - mode->height, 1, AR0234_VBLANK_MIN);
+		/* Equal VBLANK values do not invoke s_ctrl after a mode change. */
+		__v4l2_ctrl_modify_range(ar->exposure, AR0234_EXPOSURE_MIN,
+					mode->height + AR0234_VBLANK_MIN - AR0234_FLL_OVERHEAD - 1,
+					1, 100);
+		ret = __v4l2_ctrl_s_ctrl(ar->vblank, AR0234_VBLANK_MIN);
+	}
+	mutex_unlock(&ar->mutex);
+	return ret;
+}
+
+static int ar0234_get_selection(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_selection *sel)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	const struct ar0234_mode *mode;
+	int ret = 0;
+
+	if (sel->pad)
+		return -EINVAL;
+	mutex_lock(&ar->mutex);
+	mode = ar->cur_mode;
+	if (sel->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *fmt = v4l2_subdev_get_try_format(sd, state, 0);
+
+		mode = v4l2_find_nearest_size(ar0234_modes, ARRAY_SIZE(ar0234_modes),
+					     width, height, fmt->width, fmt->height);
+	}
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = mode->crop;
+		break;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r = (struct v4l2_rect) { 0, 0, AR0234_NATIVE_WIDTH, AR0234_NATIVE_HEIGHT };
+		break;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r = (struct v4l2_rect) { AR0234_PIXEL_ARRAY_LEFT, AR0234_PIXEL_ARRAY_TOP,
+					    AR0234_PIXEL_ARRAY_WIDTH, AR0234_PIXEL_ARRAY_HEIGHT };
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&ar->mutex);
+	return ret;
+}
+
+static int ar0234_get_mbus_config(struct v4l2_subdev *sd, unsigned int pad,
+				 struct v4l2_mbus_config *config)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+
+	if (pad)
+		return -EINVAL;
+	config->type = V4L2_MBUS_CSI2_DPHY;
+	config->bus.mipi_csi2 = ar->bus;
+	return 0;
+}
+
+static int ar0234_g_frame_interval(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_frame_interval *fi)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+
+	if (fi->pad)
+		return -EINVAL;
+	mutex_lock(&ar->mutex);
+	ar0234_frame_interval(ar, ar->cur_mode, ar->vblank->val, &fi->interval);
+	mutex_unlock(&ar->mutex);
+	return 0;
+}
+
+static int ar0234_s_frame_interval(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_frame_interval *fi)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	u64 fll, divisor;
+	int ret;
+
+	if (fi->pad || !fi->interval.numerator || !fi->interval.denominator)
+		return -EINVAL;
+	mutex_lock(&ar->mutex);
+	/* g_frame_interval returns an unreduced fraction with a large denominator. */
+	divisor = (u64)AR0234_HTS * fi->interval.denominator;
+	fll = div64_u64((u64)ar0234_pixel_rate(ar) * fi->interval.numerator +
+			divisor - 1, divisor);
+	fll = clamp_t(u64, fll, ar->cur_mode->height + AR0234_VBLANK_MIN, AR0234_FLL_MAX);
+	ret = __v4l2_ctrl_s_ctrl(ar->vblank, fll - ar->cur_mode->height);
+	ar0234_frame_interval(ar, ar->cur_mode, ar->vblank->val, &fi->interval);
+	mutex_unlock(&ar->mutex);
+	return ret;
+}
+
+static int ar0234_start_stream(struct ar0234 *ar)
+{
+	int ret;
+
+	ret = ar0234_write_reg(ar, AR0234_REG_RESET, 0x0001);
+	if (ret)
+		return ret;
+	usleep_range(200000, 201000);
+	ret = ar0234_write_reg(ar, AR0234_REG_RESET, AR0234_RESET_DEFAULT);
+	if (ret)
+		return ret;
+	ret = ar0234_write_sequence(ar, &ar->pll_config->regs_pll);
+	if (ret)
+		return ret;
+	ret = ar0234_write_reg(ar, AR0234_REG_SERIAL_FORMAT, 0x0200 | ar->bus.num_data_lanes);
+	if (ret)
+		return ret;
+	ret = ar0234_write_array(ar, common_init, ARRAY_SIZE(common_init));
+	if (ret)
+		return ret;
+	ar->mfr_30ba = AR0234_MFR_30BA_DEFAULT;
+	if (ar->lane_count_id == AR0234_LANE_COUNT_ID_2LANE) {
+		ret = ar0234_write_array(ar, pixclk_45mhz_mfr_settings,
+					ARRAY_SIZE(pixclk_45mhz_mfr_settings));
+		if (ret)
+			return ret;
+		ret = ar0234_write_reg(ar, AR0234_REG_MFR_30BA, AR0234_MFR_30BA_GAIN_BITS(6));
+		if (ret)
+			return ret;
+		ar->mfr_30ba = AR0234_MFR_30BA_GAIN_BITS(6);
+	}
+	/* Explicitly reset binning/orientation when changing modes. */
+	ret = ar0234_write_reg(ar, AR0234_REG_READ_MODE, 0);
+	if (ret)
+		return ret;
+	ret = ar0234_write_sequence(ar, &ar->cur_mode->reg_sequence);
+	if (ret)
+		return ret;
+	ret = ar0234_write_reg(ar, AR0234_REG_LINE_LENGTH_PCK, AR0234_LINE_LENGTH_PCK_DEF);
+	if (ret)
+		return ret;
+	ret = __v4l2_ctrl_handler_setup(&ar->ctrl_handler);
+	if (ret)
+		return ret;
+	return ar0234_write_reg(ar, AR0234_REG_MODE_SELECT, 1);
+}
+
+static int ar0234_s_stream(struct v4l2_subdev *sd, int on)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	int ret = 0;
+
+	mutex_lock(&ar->mutex);
+	on = !!on;
+	if (ar->streaming == on)
+		goto out;
+	if (on) {
+		ret = pm_runtime_resume_and_get(ar->dev);
+		if (ret < 0)
+			goto out;
+		ret = ar0234_start_stream(ar);
+		if (ret) {
+			ar0234_write_reg(ar, AR0234_REG_MODE_SELECT, 0);
+			pm_runtime_put(ar->dev);
+			goto out;
+		}
+	} else {
+		ret = ar0234_write_reg(ar, AR0234_REG_MODE_SELECT, 0);
+		if (ret)
+			goto out;
+		pm_runtime_put(ar->dev);
+	}
+	ar->streaming = on;
+	__v4l2_ctrl_grab(ar->hflip, on);
+	__v4l2_ctrl_grab(ar->vflip, on);
+out:
+	mutex_unlock(&ar->mutex);
+	return ret;
+}
+
+static int ar0234_s_power(struct v4l2_subdev *sd, int on)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	int ret = 0;
+
+	mutex_lock(&ar->mutex);
+	on = !!on;
+	if (ar->power_on != on) {
+		if (on) {
+			ret = pm_runtime_resume_and_get(ar->dev);
+			if (ret < 0)
+				goto out;
+		} else {
+			pm_runtime_put(ar->dev);
+		}
+		ar->power_on = on;
+	}
+out:
+	mutex_unlock(&ar->mutex);
+	return ret < 0 ? ret : 0;
+}
+
+static long ar0234_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+	struct rkmodule_inf *inf = arg;
+	struct rkmodule_hdr_cfg *hdr = arg;
+	struct rkmodule_channel_info *channel = arg;
+	long ret = 0;
+
+	mutex_lock(&ar->mutex);
+	switch (cmd) {
+	case RKMODULE_GET_MODULE_INFO:
+		memset(inf, 0, sizeof(*inf));
+		strscpy(inf->base.sensor, "ar0234", sizeof(inf->base.sensor));
+		strscpy(inf->base.module, ar->module_name, sizeof(inf->base.module));
+		strscpy(inf->base.lens, ar->lens_name, sizeof(inf->base.lens));
+		break;
+	case RKMODULE_GET_HDR_CFG:
+		memset(hdr, 0, sizeof(*hdr));
+		hdr->esp.mode = HDR_NORMAL_VC;
+		hdr->hdr_mode = NO_HDR;
+		break;
+	case RKMODULE_SET_HDR_CFG:
+		if (hdr->hdr_mode != NO_HDR)
+			ret = -EINVAL;
+		break;
+	case RKMODULE_GET_CHANNEL_INFO:
+		if (channel->index) {
+			ret = -EINVAL;
+			break;
+		}
+		memset(channel, 0, sizeof(*channel));
+		channel->width = ar->cur_mode->width;
+		channel->height = ar->cur_mode->height;
+		channel->bus_fmt = ar0234_get_format_code(ar);
+		channel->data_bit = ar->pll_config->freq_link == AR0234_FREQ_LINK_8BIT ? 8 : 10;
+		channel->data_type = channel->data_bit == 8 ? 0x2a : 0x2b;
+		channel->field = V4L2_FIELD_NONE;
+		break;
+	default:
+		ret = -ENOIOCTLCMD;
+	}
+	mutex_unlock(&ar->mutex);
+	/* Route quick stream through normal setup/PM instead of bypassing it. */
+	if (cmd == RKMODULE_SET_QUICK_STREAM)
+		return ar0234_s_stream(sd, !!(*(u32 *)arg));
+	return ret;
+}
+
+#ifdef CONFIG_COMPAT
+static long ar0234_compat_ioctl32(struct v4l2_subdev *sd,
+					unsigned int cmd, unsigned long arg)
+{
+	void __user *up = compat_ptr(arg);
+	void *data;
+	size_t size;
+	bool input = false;
+	long ret;
+
+	switch (cmd) {
+	case RKMODULE_GET_MODULE_INFO:
+		size = sizeof(struct rkmodule_inf);
+		break;
+	case RKMODULE_GET_HDR_CFG:
+	case RKMODULE_SET_HDR_CFG:
+		size = sizeof(struct rkmodule_hdr_cfg);
+		input = cmd == RKMODULE_SET_HDR_CFG;
+		break;
+	case RKMODULE_GET_CHANNEL_INFO:
+		size = sizeof(struct rkmodule_channel_info);
+		input = true;
+		break;
+	case RKMODULE_SET_QUICK_STREAM:
+		size = sizeof(u32);
+		input = true;
+		break;
+	default:
+		return -ENOIOCTLCMD;
+	}
+	data = kzalloc(size, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	if (input && copy_from_user(data, up, size)) {
+		ret = -EFAULT;
+		goto out;
+	}
+	ret = ar0234_ioctl(sd, cmd, data);
+	if (!ret && cmd != RKMODULE_SET_HDR_CFG && cmd != RKMODULE_SET_QUICK_STREAM &&
+	    copy_to_user(up, data, size))
+		ret = -EFAULT;
+out:
+	kfree(data);
+	return ret;
+}
+#endif
+
+static int ar0234_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct ar0234 *ar = to_ar0234(sd);
+
+	mutex_lock(&ar->mutex);
+	ar0234_fill_format(ar, ar->cur_mode, v4l2_subdev_get_try_format(sd, fh->state, 0));
+	mutex_unlock(&ar->mutex);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops ar0234_internal_ops = {
+	.open = ar0234_open,
+};
+
+static const struct v4l2_subdev_core_ops ar0234_core_ops = {
+	.s_power = ar0234_s_power,
+	.ioctl = ar0234_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl32 = ar0234_compat_ioctl32,
+#endif
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_subdev_video_ops ar0234_video_ops = {
+	.s_stream = ar0234_s_stream,
+	.g_frame_interval = ar0234_g_frame_interval,
+	.s_frame_interval = ar0234_s_frame_interval,
+};
+
+static const struct v4l2_subdev_pad_ops ar0234_pad_ops = {
+	.enum_mbus_code = ar0234_enum_mbus_code,
+	.enum_frame_size = ar0234_enum_frame_size,
+	.enum_frame_interval = ar0234_enum_frame_interval,
+	.get_fmt = ar0234_get_fmt,
+	.set_fmt = ar0234_set_fmt,
+	.get_selection = ar0234_get_selection,
+	.get_mbus_config = ar0234_get_mbus_config,
+};
+
+static const struct v4l2_subdev_ops ar0234_subdev_ops = {
+	.core = &ar0234_core_ops,
+	.video = &ar0234_video_ops,
+	.pad = &ar0234_pad_ops,
+};
+
+static int ar0234_power_on(struct device *dev)
+{
+	struct ar0234 *ar = to_ar0234(i2c_get_clientdata(to_i2c_client(dev)));
+	int ret;
+
+	/* GPIO values are logical: 1 asserts reset/PWDN, 0 releases them. */
+	gpiod_set_value_cansleep(ar->reset_gpio, 1);
+	gpiod_set_value_cansleep(ar->pwdn_gpio, 1);
+	ret = regulator_bulk_enable(AR0234_NUM_SUPPLIES, ar->supplies);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(ar->xvclk);
+	if (ret) {
+		regulator_bulk_disable(AR0234_NUM_SUPPLIES, ar->supplies);
+		return ret;
+	}
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ar->pwdn_gpio, 0);
+	gpiod_set_value_cansleep(ar->reset_gpio, 0);
+	usleep_range(20000, 21000);
+	return 0;
+}
+
+static int ar0234_power_off(struct device *dev)
+{
+	struct ar0234 *ar = to_ar0234(i2c_get_clientdata(to_i2c_client(dev)));
+
+	gpiod_set_value_cansleep(ar->reset_gpio, 1);
+	gpiod_set_value_cansleep(ar->pwdn_gpio, 1);
+	clk_disable_unprepare(ar->xvclk);
+	regulator_bulk_disable(AR0234_NUM_SUPPLIES, ar->supplies);
+	return 0;
+}
+
+static int ar0234_parse_hw_config(struct ar0234 *ar)
+{
+	struct device *dev = ar->dev;
+	struct device_node *node = dev->of_node;
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *endpoint;
+	u64 frequency;
+	unsigned int i;
+	int ret;
+
+	ret = of_property_read_u32(node, RKMODULE_CAMERA_MODULE_INDEX, &ar->module_index);
+	ret |= of_property_read_string(node, RKMODULE_CAMERA_MODULE_FACING, &ar->module_facing);
+	ret |= of_property_read_string(node, RKMODULE_CAMERA_MODULE_NAME, &ar->module_name);
+	ret |= of_property_read_string(node, RKMODULE_CAMERA_LENS_NAME, &ar->lens_name);
+	if (ret)
+		return dev_err_probe(dev, -EINVAL, "missing Rockchip camera module properties\n");
+
+	ar->xvclk = devm_clk_get(dev, "xvclk");
+	if (IS_ERR(ar->xvclk) && PTR_ERR(ar->xvclk) == -ENOENT)
+		ar->xvclk = devm_clk_get(dev, "extclk");
+	if (IS_ERR(ar->xvclk))
+		return dev_err_probe(dev, PTR_ERR(ar->xvclk), "missing input clock\n");
+	/* Do not silently retune an unknown module oscillator or PLL. */
+	if (clk_get_rate(ar->xvclk) != AR0234_FREQ_EXTCLK)
+		return dev_err_probe(dev, -EINVAL, "only 24 MHz input clock is supported\n");
+
+	ar->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ar->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ar->reset_gpio), "failed to get reset GPIO\n");
+	ar->pwdn_gpio = devm_gpiod_get_optional(dev, "pwdn", GPIOD_OUT_HIGH);
+	if (IS_ERR(ar->pwdn_gpio))
+		return dev_err_probe(dev, PTR_ERR(ar->pwdn_gpio), "failed to get PWDN GPIO\n");
+	for (i = 0; i < AR0234_NUM_SUPPLIES; i++)
+		ar->supplies[i].supply = ar0234_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, AR0234_NUM_SUPPLIES, ar->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get sensor supplies\n");
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "missing CSI endpoint\n");
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		goto out;
+	if (ep.bus.mipi_csi2.num_data_lanes != 2 && ep.bus.mipi_csi2.num_data_lanes != 4) {
+		ret = dev_err_probe(dev, -EINVAL, "expected 2 or 4 data lanes\n");
+		goto out;
+	}
+	/* This port supports straight lane order only. */
+	for (i = 0; i < ep.bus.mipi_csi2.num_data_lanes; i++) {
+		if (ep.bus.mipi_csi2.data_lanes[i] != i + 1 || ep.bus.mipi_csi2.lane_polarities[i + 1]) {
+			ret = dev_err_probe(dev, -EINVAL, "unsupported CSI lane mapping\n");
+			goto out;
+		}
+	}
+	if (!(ep.bus.mipi_csi2.flags & V4L2_MBUS_CSI2_NONCONTINUOUS_CLOCK)) {
+		ret = dev_err_probe(dev, -EINVAL, "reference PLL requires clock-noncontinuous\n");
+		goto out;
+	}
+	if (ep.bus.mipi_csi2.clock_lane || ep.bus.mipi_csi2.lane_polarities[0] ||
+	    ep.nr_of_link_frequencies != 1) {
+		ret = dev_err_probe(dev, -EINVAL, "specify clock lane 0 and one link frequency\n");
+		goto out;
+	}
+	frequency = ep.link_frequencies[0];
+	for (i = 0; i < ARRAY_SIZE(ar0234_pll_configs); i++) {
+		if (ar0234_pll_configs[i].freq_link == frequency) {
+			ar->pll_config = &ar0234_pll_configs[i];
+			break;
+		}
+	}
+	if (!ar->pll_config) {
+		ret = dev_err_probe(dev, -EINVAL, "unsupported link frequency %llu\n", frequency);
+		goto out;
+	}
+	ar->bus = ep.bus.mipi_csi2;
+	ar->lane_count_id = ar->bus.num_data_lanes == 2 ?
+		AR0234_LANE_COUNT_ID_2LANE : AR0234_LANE_COUNT_ID_4LANE;
+	/* Only free-running capture is implemented until module pins are confirmed. */
+	if (of_property_present(node, "trigger-mode") || of_property_present(node, "flash")) {
+		ret = dev_err_probe(dev, -EINVAL, "trigger/flash not implemented in this port\n");
+		goto out;
+	}
+	dev_info(dev, "%u lanes, %llu Hz link, 24 MHz input (unvalidated module)\n",
+		 ar->bus.num_data_lanes, frequency);
+	ret = 0;
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int ar0234_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ar0234 *ar;
+	u16 id;
+	int ret;
+
+	ar = devm_kzalloc(dev, sizeof(*ar), GFP_KERNEL);
+	if (!ar)
+		return -ENOMEM;
+	ar->dev = dev;
+	ar->client = client;
+	ar->cur_mode = &ar0234_modes[0];
+	mutex_init(&ar->mutex);
+	v4l2_i2c_subdev_init(&ar->sd, client, &ar0234_subdev_ops);
+	ret = ar0234_parse_hw_config(ar);
+	if (ret)
+		goto err_mutex;
+	ret = ar0234_power_on(dev);
+	if (ret)
+		goto err_mutex;
+	ret = ar0234_read_reg(ar, AR0234_REG_CHIP_ID, &id);
+	if (ret)
+		goto err_power;
+	if (id != AR0234_CHIP_ID && id != AR0234_CHIP_ID_MONO) {
+		ret = dev_err_probe(dev, -ENODEV, "unexpected chip ID 0x%04x\n", id);
+		goto err_power;
+	}
+	ar->monochrome = id == AR0234_CHIP_ID_MONO;
+	dev_info(dev, "AR0234 chip ID 0x%04x (%s)\n", id, ar->monochrome ? "mono" : "Bayer");
+	/* Enter LP-11 as in the reference driver. */
+	ret = ar0234_write_reg(ar, AR0234_REG_MODE_SELECT, 1);
+	if (ret)
+		goto err_power;
+	usleep_range(100, 110);
+	ret = ar0234_write_reg(ar, AR0234_REG_MODE_SELECT, 0);
+	if (ret)
+		goto err_power;
+	usleep_range(100, 110);
+	ret = ar0234_init_controls(ar);
+	if (ret)
+		goto err_power;
+	ar->sd.internal_ops = &ar0234_internal_ops;
+	ar->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_HAS_EVENTS;
+	ar->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ar->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ar->sd.entity, 1, &ar->pad);
+	if (ret)
+		goto err_controls;
+	snprintf(ar->sd.name, sizeof(ar->sd.name), "m%02u_%c_ar0234 %s",
+		 ar->module_index, !strcmp(ar->module_facing, "back") ? 'b' : 'f', dev_name(dev));
+	/* Runtime PM must be ready before async registration exposes the device. */
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_get_noresume(dev);
+	ret = v4l2_async_register_subdev_sensor(&ar->sd);
+	if (ret) {
+		pm_runtime_put_noidle(dev);
+		pm_runtime_disable(dev);
+		goto err_entity;
+	}
+	pm_runtime_put(dev);
+	return 0;
+err_entity:
+	media_entity_cleanup(&ar->sd.entity);
+err_controls:
+	v4l2_ctrl_handler_free(&ar->ctrl_handler);
+err_power:
+	ar0234_power_off(dev);
+err_mutex:
+	mutex_destroy(&ar->mutex);
+	return ret;
+}
+
+static void ar0234_remove(struct i2c_client *client)
+{
+	struct ar0234 *ar = to_ar0234(i2c_get_clientdata(client));
+
+	v4l2_async_unregister_subdev(&ar->sd);
+	pm_runtime_disable(ar->dev);
+	if (!pm_runtime_status_suspended(ar->dev))
+		ar0234_power_off(ar->dev);
+	pm_runtime_set_suspended(ar->dev);
+	media_entity_cleanup(&ar->sd.entity);
+	v4l2_ctrl_handler_free(&ar->ctrl_handler);
+	mutex_destroy(&ar->mutex);
+}
