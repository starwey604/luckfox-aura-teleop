#!/usr/bin/env python3
"""Native viewer sync/async A/B using bounded real-board stereo captures."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--viewer', type=Path, default=ROOT / 'build/host/bin/host-viewer')
    parser.add_argument('--headless-pairs', type=int, choices=range(4), default=3,
                        help='0..3 paired headless groups; two display runs always follow')
    parser.add_argument('--host', default='root@192.168.1.10')
    parser.add_argument('--adb-serial', default='4a988b5514157df5')
    args = parser.parse_args()
    if Path('/run/.containerenv').exists() or Path('/.dockerenv').exists():
        parser.error('Run on the native CachyOS host')
    args.output.mkdir(parents=True, exist_ok=False)
    ssh = ['ssh', '-o', 'ConnectTimeout=5', args.host]
    if 'SSHPASS' in os.environ:
        ssh = ['sshpass', '-e', *ssh]
    def remote(command):
        return subprocess.check_output([*ssh, command], text=True, timeout=15).strip()
    adb = ['adb', '-s', args.adb_serial, 'shell']
    boot = remote('cat /proc/sys/kernel/random/boot_id')
    identity = remote('uname -a; sha256sum /userdata/teleop-sender /userdata/run-ar0234-stereo; '
                      'cat /sys/class/thermal/thermal_zone0/temp')
    (args.output / 'board-identity.txt').write_text(identity + '\n')
    runs = []
    capture = None
    reader_pid = None
    marker = f'teleop-viewer-pipeline-{time.monotonic_ns()}'
    kmsg = args.output / 'usb-kmsg.txt'
    with kmsg.open('w') as log:
        try:
            # Owned reader shell traps TERM/HUP and reaps its own cat child.
            command = "timeout 180 sh -c 'echo usb_reader_pid=$$; cat /dev/kmsg & child=$!; " \
                      "trap \"kill $child 2>/dev/null; wait $child 2>/dev/null; exit 0\" TERM INT HUP; wait $child'"
            capture = subprocess.Popen([*adb, command], stdout=log, stderr=subprocess.STDOUT)
            time.sleep(.3)
            subprocess.run([*adb, f'echo {marker} >/dev/kmsg'], check=True, timeout=10,
                           stdout=subprocess.DEVNULL)
            deadline = time.monotonic() + 5
            while marker not in kmsg.read_text(errors='replace'):
                if capture.poll() is not None or time.monotonic() >= deadline:
                    raise RuntimeError('USB live marker not received; no cameras started')
                time.sleep(.05)
            reader_pid = re.search(r'^usb_reader_pid=(\d+)', kmsg.read_text(), re.M)[1]
            cases = [(f'headless-{index}-{mode}', mode, False)
                     for index in range(1, args.headless_pairs + 1) for mode in ('sync', 'async')]
            cases += [(f'display-{mode}', mode, True) for mode in ('sync', 'async')]
            for name, mode, display in cases:
                if remote('cat /proc/sys/kernel/random/boot_id') != boot:
                    raise RuntimeError('Board rebooted; stop')
                path = args.output / name
                command = [str(ROOT / 'tools/test-aura-software-baseline'), '--camera', 'dual',
                           '--frames', '120', '--viewer', str(args.viewer), '--viewer-pipeline', mode,
                           '--rx-batch-size', '1',
                           '--host', args.host, '--output', str(path)]
                if display:
                    command += ['--display']
                if mode == 'async':
                    command += ['--queue-report-ms', '250']
                subprocess.run(command, check=True, timeout=60)
                text = (path / 'viewer.txt').read_text()
                result = json.loads((path / 'result.json').read_text())
                if 'rxq_overflow=0' not in text:
                    raise RuntimeError('RX overflow or missing observer')
                if mode == 'async' and len(re.findall(r'queue: stream=\d .*overflows=0', text)) != 2:
                    raise RuntimeError('Encoded queue overflow or missing observations')
                runs.append({'name': name, 'result': result})
                if re.search(r'BUG:|WARNING:|soft lockup|hard LOCKUP',
                             kmsg.read_text(errors='replace').split(marker, 1)[1]):
                    raise RuntimeError('Kernel fault after USB marker; stop')
            if remote('cat /proc/sys/kernel/random/boot_id') != boot:
                raise RuntimeError('Board rebooted during final test')
            (args.output / 'board-after.txt').write_text(remote(
                'cat /sys/class/thermal/thermal_zone0/temp; ps; cat /proc/net/snmp') + '\n')
        finally:
            if reader_pid:
                subprocess.run([*adb, f'kill {reader_pid}'], timeout=10,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if capture and capture.poll() is None:
                capture.terminate()
                capture.wait(timeout=10)
    summary = {'boot_id': boot, 'viewer_sha256': hashlib.sha256(args.viewer.read_bytes()).hexdigest(),
               'hardware_frames': len(runs) * 240, 'frames_per_camera_per_run': 120,
               'runs': runs, 'measurement': 'local software stages; no optical or cross-host latency'}
    (args.output / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(f'PASS: {len(runs)} short stereo runs / {summary["hardware_frames"]} hardware frames')


if __name__ == '__main__':
    main()
