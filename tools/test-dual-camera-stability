#!/bin/sh
# Aura dual-MIA1321 stability test.
#
# Runs on the board.  For each scenario it starts one or both ISP mainpath
# capture nodes and samples the hardware counters *while the stream is
# running* (the rkcif/rkisp proc files only expose the per-stream counters
# then).  Reported per camera:
#
#   fps      achieved capture rate for COUNT frames
#   cif_rx   frames the CSI receiver handed to the CIF
#   isp_rx   frames the ISP delivered on rkisp_mainpath
#   cif_los  CIF "frame loss"                    (drops)
#   isp_los  rkisp_mainpath "frameloss"          (drops)
#   cif_err  CIF csi size/overflow/bandwidth/all errors
#   isp_err  rkisp "ErrCnt"
#
# A healthy run shows fps close to the mode rate, cif_rx ~= isp_rx ~= COUNT
# and zero loss/error counters.
#
# Run it on the board:
#   COUNT=600 ./test-dual-camera-stability
# or from the host without copying it over:
#   ssh root@192.168.1.10 'sh -s' < tools/test-dual-camera-stability
#
# Environment:
#   COUNT         frames per camera per scenario        (default 600)
#   SCENARIOS     space separated: solo0 solo1 dual     (default all three)
#   MODE_FPS      if set, write it to mia1321 mode_fps  (default: leave as is)
#   RESET_PARAMS  1 clears the PLL/register overrides   (default 1)
#   STOP_SENDER   1 stops a running teleop-sender       (default 0)
#   TIMEOUT       per-camera watchdog seconds           (default COUNT/20 + 20)
#
# Topology assumed by rv1126b-luckfox-aura-dual-cam.dtsi:
#   cam0 = mia1321_0 @ i2c4 -> rkcif-mipi-lvds  -> rkisp-vir0
#   cam1 = mia1321_1 @ i2c3 -> rkcif-mipi-lvds2 -> rkisp-vir1

set -u

COUNT=${COUNT:-600}
SCENARIOS=${SCENARIOS:-"solo0 solo1 dual"}
MODE_FPS=${MODE_FPS:-}
RESET_PARAMS=${RESET_PARAMS:-1}
TIMEOUT=${TIMEOUT:-$((COUNT / 20 + 20))}
PARAM_DIR=${PARAM_DIR:-/sys/module/mia1321/parameters}
TMP=${TMP:-/tmp}

FAILED=0

# ---------------------------------------------------------------------------
# Topology helpers
# ---------------------------------------------------------------------------
cam_bus()    { case "$1" in 0) echo 4 ;; 1) echo 3 ;; esac; }
cam_vir()    { echo "rkisp-vir$1"; }
cam_cif()    { case "$1" in 0) echo /proc/rkcif-mipi-lvds ;; 1) echo /proc/rkcif-mipi-lvds2 ;; esac; }
cam_isp()    { echo "/proc/rkisp-vir$1"; }

media_driver() {
	media-ctl -d "$1" -p 2>/dev/null | sed -n 's/^driver[[:space:]]*//p' | head -1
}

find_media() { # $1 = media driver name
	for m in /dev/media*; do
		[ -c "$m" ] || continue
		[ "$(media_driver "$m")" = "$1" ] && { echo "$m"; return 0; }
	done
	return 1
}

mainpath_of() { # $1 = media device
	media-ctl -d "$1" -p 2>/dev/null | awk '
		/^- entity .*: rkisp_mainpath / { f = 1; next }
		f && /device node name/ { print $NF; exit }'
}

sensor_entity() { # $1 = i2c bus -> "media|entity"
	for m in /dev/media*; do
		[ -c "$m" ] || continue
		e=$(media-ctl -d "$m" -p 2>/dev/null |
			sed -n "s/^- entity [0-9]*: \(.*mia1321 ${1}-0060\) (.*/\1/p" | head -1)
		[ -n "$e" ] && { printf '%s|%s\n' "$m" "$e"; return 0; }
	done
	return 1
}

cam_video() { # $1 = camera index -> capture node
	m=$(find_media "$(cam_vir "$1")") || return 1
	mainpath_of "$m"
}

# ---------------------------------------------------------------------------
# Counter readers (empty when a counter is unavailable)
# ---------------------------------------------------------------------------
cif_frames()   { sed -n 's/.*frame amount:\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1; }
cif_allerr()   { sed -n 's/.*all err count:\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1; }
cif_sizeerr()  { sed -n 's/.*csi size err:\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1; }
cif_overflow() { sed -n 's/.*csi over flow:\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1; }
cif_bwlack()   { sed -n 's/.*csi bandwidth lack:\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1; }
cif_loss()     { awk '/frame loss:/ { s = 0; for (i = 3; i <= NF; i++) s += $i; print s + 0; exit }' "$1" 2>/dev/null; }
isp_frame()    { sed -n 's/.*(frame:\([0-9][0-9]*\) rate:.*/\1/p' "$1" 2>/dev/null | head -1; }
isp_frameloss(){ sed -n 's/.*frameloss:\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1; }
isp_errcnt()   { sed -n 's/.*Interrupt[[:space:]]*Cnt:[0-9][0-9]* ErrCnt:\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -1; }

nz() { [ -n "${1:-}" ] && printf '%s' "$1" || printf '0'; }

# sample <cam> -> one line: cif_rx cif_loss cif_err isp_rx isp_loss isp_err
sample() {
	c=$1
	cp=$(cam_cif "$c")
	ip=$(cam_isp "$c")
	cerr=$(( $(nz "$(cif_allerr "$cp")") + $(nz "$(cif_sizeerr "$cp")") \
		+ $(nz "$(cif_overflow "$cp")") + $(nz "$(cif_bwlack "$cp")") ))
	printf '%s %s %s %s %s %s\n' \
		"$(nz "$(cif_frames "$cp")")" "$(nz "$(cif_loss "$cp")")" "$cerr" \
		"$(nz "$(isp_frame "$ip")")" "$(nz "$(isp_frameloss "$ip")")" \
		"$(nz "$(isp_errcnt "$ip")")"
}

# sampler <cam> <outfile> <stopfile>: keep the last counters seen while the
# stream is running (the proc files are empty once it stops).
sampler() {
	c=$1
	out=$2
	stop=$3
	while [ ! -e "$stop" ]; do
		sample "$c" > "$out.tmp" 2>/dev/null && mv "$out.tmp" "$out"
		sleep 0.2
	done
}

# ---------------------------------------------------------------------------
# One capture
# ---------------------------------------------------------------------------
capture_one() { # $1 = video node, $2 = result file
	video=$1
	out=$2
	t0=$(date +%s.%N)
	timeout -s INT -k 3 "$TIMEOUT" v4l2-ctl -d "$video" \
		--stream-mmap=4 --stream-count="$COUNT" --stream-to=/dev/null \
		>/dev/null 2>&1
	rc=$?
	t1=$(date +%s.%N)
	printf '%s %s %s\n' "$rc" "$t0" "$t1" > "$out"
}

# ---------------------------------------------------------------------------
# Scenario runner
# ---------------------------------------------------------------------------
run_scenario() {
	name=$1
	shift
	cams=$*

	echo
	echo "=== scenario: $name ($cams), $COUNT frames each ==="

	# Force a sensor S_FMT so the selected mode_fps is applied on every run,
	# and resolve the capture nodes up front.
	for c in $cams; do
		se=$(sensor_entity "$(cam_bus "$c")") || continue
		media-ctl -d "${se%%|*}" --set-v4l2 "\"${se#*|}\":0[fmt:SGRBG10_1X10/1280x1080]" \
			>/dev/null 2>&1
		eval "V$c=$(cam_video "$c")"
	done

	dmesg -c >/dev/null 2>&1
	stop="$TMP/dcam.$name.stop"
	rm -f "$stop" "$TMP"/dcam."$name".*.res "$TMP"/dcam."$name".*.samp

	cpids=""
	for c in $cams; do
		eval "v=\$V$c"
		( capture_one "$v" "$TMP/dcam.$name.$c.res" ) & cpids="$cpids $!"
	done
	spids=""
	for c in $cams; do
		( sampler "$c" "$TMP/dcam.$name.$c.samp" "$stop" ) & spids="$spids $!"
	done

	# Wait for the captures, then stop the samplers (their last sample is
	# the final counter value observed while the stream was still up).
	for p in $cpids; do wait "$p"; done
	: > "$stop"
	for p in $spids; do wait "$p"; done

	printf '%-3s %-12s %-4s %-7s %-7s %-7s %-7s %-7s %-7s %-7s %-6s\n' \
		cam video rc fps cif_rx isp_rx cif_los isp_los cif_err isp_err verdict

	for c in $cams; do
		eval "video=\$V$c"
		res=$(cat "$TMP/dcam.$name.$c.res" 2>/dev/null || echo MISSING)

		if [ "$res" = "MISSING" ]; then
			printf '%-3s %-12s %s\n' "$c" "-" \
				"NOT FOUND (camera disconnected or single-camera DTB)"
			FAILED=1
			continue
		fi

		rc=$(printf '%s' "$res" | awk '{print $1}')
		t0=$(printf '%s' "$res" | awk '{print $2}')
		t1=$(printf '%s' "$res" | awk '{print $3}')
		fps=$(awk -v n="$COUNT" -v a="$t0" -v b="$t1" \
			'BEGIN { if (b > a) printf "%.1f", n / (b - a); else printf "0" }')

		samp=$(tail -1 "$TMP/dcam.$name.$c.samp" 2>/dev/null)
		rx=$(printf '%s' "$samp" | awk '{print $1+0}')
		closs=$(printf '%s' "$samp" | awk '{print $2+0}')
		cerr=$(printf '%s' "$samp" | awk '{print $3+0}')
		iframe=$(printf '%s' "$samp" | awk '{print $4+0}')
		iloss=$(printf '%s' "$samp" | awk '{print $5+0}')
		ierr=$(printf '%s' "$samp" | awk '{print $6+0}')

		verdict=OK
		[ "$rc" -eq 0 ] || verdict="rc=$rc"
		[ "$closs" -eq 0 ] && [ "$iloss" -eq 0 ] || verdict=DROP
		[ "$cerr" -eq 0 ] || verdict=ERR
		# Frames must actually reach the ISP; a busy node delivers almost none.
		[ "$iframe" -ge $((COUNT * 9 / 10)) ] || verdict="LOW"
		[ "$verdict" = OK ] || FAILED=1

		printf '%-3s %-12s %-4s %-7s %-7s %-7s %-7s %-7s %-7s %-7s %-6s\n' \
			"$c" "$(basename "$video")" "$rc" "$fps" "$rx" "$iframe" \
			"$closs" "$iloss" "$cerr" "$ierr" "$verdict"
	done

	dmesg_err=$(dmesg 2>/dev/null |
		grep -cE 'MIPI_CSI2 ERR|size err|bandwidth lack|overflow' || true)
	echo "dmesg error lines: $dmesg_err"
	[ "$dmesg_err" -eq 0 ] || FAILED=1
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
echo "=== Aura dual MIA1321 stability test ==="
echo "kernel : $(uname -r)"
echo "count  : $COUNT   scenarios: $SCENARIOS   timeout: ${TIMEOUT}s"

# The capture nodes cannot be shared; a running camera application makes every
# capture fail.  Match on the process name only (/proc/<pid>/comm) so this
# script's own command line cannot match itself.
busy=""
for p in /proc/[0-9]*; do
	[ -r "$p/comm" ] || continue
	name=$(cat "$p/comm" 2>/dev/null) || continue
	case "$name" in
	teleop-sender | rkaiq | rkipc | rkisp_demo | usb-camera*)
		busy="$busy ${p#/proc/}:$name"
		;;
	esac
done
if [ -n "$busy" ]; then
	echo "warning: camera application(s) currently running:"
	for b in $busy; do printf '  pid %s %s\n' "${b%%:*}" "${b#*:}"; done
	if [ "${STOP_SENDER:-0}" = 1 ]; then
		echo "STOP_SENDER=1: stopping teleop-sender"
		killall teleop-sender 2>/dev/null || true
		sleep 2
	else
		echo "error: stop them first (or set STOP_SENDER=1 to stop teleop-sender)" >&2
		exit 2
	fi
fi

if [ "$RESET_PARAMS" = 1 ] && [ -d "$PARAM_DIR" ]; then
	for p in link_freq_mhz pll_fbdiv pll_outdiv pll_div_adc pll_div_bitclk \
		 pll_div_pclk pll_div_cpclk; do
		[ -w "$PARAM_DIR/$p" ] && echo 0 > "$PARAM_DIR/$p"
	done
	[ -w "$PARAM_DIR/regs" ] && echo "" > "$PARAM_DIR/regs"
fi
if [ -n "$MODE_FPS" ] && [ -w "$PARAM_DIR/mode_fps" ]; then
	echo "$MODE_FPS" > "$PARAM_DIR/mode_fps"
fi

if [ -f "$PARAM_DIR/mode_fps" ]; then
	printf 'params : mode_fps=%s link=%s fbdiv=%s outdiv=%s regs=%s\n' \
		"$(cat "$PARAM_DIR/mode_fps")" "$(cat "$PARAM_DIR/link_freq_mhz" 2>/dev/null)" \
		"$(cat "$PARAM_DIR/pll_fbdiv" 2>/dev/null)" \
		"$(cat "$PARAM_DIR/pll_outdiv" 2>/dev/null)" \
		"$(cat "$PARAM_DIR/regs" 2>/dev/null)"
fi

for c in 0 1; do
	se=$(sensor_entity "$(cam_bus "$c")" 2>/dev/null || true)
	video=$(cam_video "$c" 2>/dev/null || true)
	if [ -n "$se" ]; then sens=${se#*|}; else sens="<none>"; fi
	printf 'cam%d   : sensor=%-28s capture=%s\n' "$c" "$sens" "${video:-<none>}"
done

for s in $SCENARIOS; do
	case "$s" in
	solo0) run_scenario "$s" 0 ;;
	solo1) run_scenario "$s" 1 ;;
	dual)  run_scenario "$s" 0 1 ;;
	*)     echo "unknown scenario: $s" >&2 ;;
	esac
done

echo
if [ "$FAILED" -eq 0 ]; then
	echo "result : PASS (no frame loss, no errors)"
else
	echo "result : FAIL (see the rows above)"
fi
exit "$FAILED"
