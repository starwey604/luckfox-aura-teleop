#!/bin/sh
# Exercise two independent transport stream IDs through one dual-stream viewer.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
build_dir=${1:-"$root/build/dual-transport-loopback"}
viewer_output="$build_dir/viewer-output.txt"

cmake -S "$root" -B "$build_dir" \
    -DCMAKE_BUILD_TYPE=Release \
    -DTELEOP_BUILD_AURA_SENDER=OFF \
    -DTELEOP_BUILD_TRANSPORT_TEST_SENDER=ON \
    -DTELEOP_BUILD_HOST_VIEWER=ON \
    -DTELEOP_BUILD_TESTS=ON
cmake --build "$build_dir"
ctest --test-dir "$build_dir" --output-on-failure

"$build_dir/bin/host-viewer" --port 5002 --frames 180 --timeout-ms 3000 \
    --dual-stream --transport-only > "$viewer_output" &
viewer_pid=$!
sleep 1
"$build_dir/bin/transport-test-sender" --destination 127.0.0.1 --port 5002 \
    --stream-id 0 --frames 90 --frame-bytes 24000 --fps 120 &
sender_zero_pid=$!
"$build_dir/bin/transport-test-sender" --destination 127.0.0.1 --port 5002 \
    --stream-id 1 --frames 90 --frame-bytes 24000 --fps 120 &
sender_one_pid=$!
wait "$sender_zero_pid"
wait "$sender_one_pid"
wait "$viewer_pid"
cat "$viewer_output"
