#!/bin/sh
# Select the project-owned Teleop BoardConfig in an Aura SDK checkout.
set -eu

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
	printf '%s\n' "usage: $0 <aura-sdk-path> [mia1321|ar0234|ar0234-stereo]" >&2
	exit 2
}

sdk=$(CDPATH= cd -- "$1" && pwd)
case "${2:-mia1321}" in
	mia1321) suffix=Teleop ;;
	ar0234) suffix=Teleop-AR0234 ;;
	ar0234-stereo) suffix=Teleop-AR0234-Stereo ;;
	*) printf '%s\n' 'error: camera profile must be mia1321, ar0234 or ar0234-stereo' >&2; exit 2 ;;
esac
board="$sdk/project/cfg/BoardConfig_Aura/BoardConfig-EMMC-RK801-Luckfox_Aura-$suffix-Buildroot.mk"

[ -f "$board" ] || {
	printf '%s\n' "error: Teleop BoardConfig is missing: $board" >&2
	printf '%s\n' "       apply the BoardConfig patch stack first" >&2
	exit 1
}

ln -sfn "$board" "$sdk/.BoardConfig.mk"
printf '%s\n' "selected: $(readlink -f "$sdk/.BoardConfig.mk")"
