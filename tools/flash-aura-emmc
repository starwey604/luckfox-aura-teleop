#!/bin/sh
# Flash the complete current Aura teleop image through Rockchip USB Loader.
#
# The vendor rkdownload.sh cannot flash this BoardConfig's growable rootfs
# partition because it passes "-" as a sector count. Keep the layout here
# explicit and omit that optional count for rootfs.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
sdk=${AURA_SDK_ROOT:-"$root/../aura-sdk"}
images=
dry_run=false

usage() {
    printf '%s\n' "usage: $(basename "$0") [--dry-run] [--sdk <aura-sdk-path>] [--images <saved-image-directory>]"
    exit 2
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run) dry_run=true ;;
        --sdk)
            [ "$#" -ge 2 ] || usage
            sdk=$2
            shift
            ;;
        --images)
            [ "$#" -ge 2 ] || usage
            images=$2
            shift
            ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
    shift
done

sdk=$(CDPATH= cd -- "$sdk" && pwd)
images=${images:-"$sdk/output/image"}
images=$(CDPATH= cd -- "$images" && pwd)
tool_dir="$sdk/tools/linux/Linux_Upgrade_Tool"
tool="$tool_dir/upgrade_tool"

[ -x "$tool" ] || {
    printf '%s\n' "error: upgrade_tool is missing: $tool" >&2
    exit 1
}

for image in download.bin env.img idblock.img uboot.img boot.img userdata.img oem.img rootfs.img; do
    [ -s "$images/$image" ] || {
        printf '%s\n' "error: image is missing or empty: $images/$image" >&2
        exit 1
    }
done

# These values are deliberately tied to the current teleop BoardConfig.
expected_parts='blkdevparts=mmcblk0:32K(env),512K@32K(idblock),4M(uboot),11M(boot),1G(userdata),2G(oem),-(rootfs)'
actual_parts=$(strings "$images/env.img" | head -n 1)
# Rockchip's environment image carries a short printable header before the
# actual variable name; it is not part of the partition table.
actual_parts=${actual_parts#<oG}
[ "$actual_parts" = "$expected_parts" ] || {
    printf '%s\n' "error: env.img has an unexpected partition layout:" >&2
    printf '%s\n' "  $actual_parts" >&2
    exit 1
}

cd "$tool_dir"

run_tool() {
    if [ "$dry_run" = true ]; then
        printf 'sudo %s' "$tool"
        for arg in "$@"; do
            printf ' %s' "$arg"
        done
        printf '\n'
    else
        sudo "$tool" "$@"
    fi
}

if [ "$dry_run" = false ]; then
    device_info=$(run_tool ld 2>&1 || true)
    case "$device_info" in
        *Maskrom*|*MaskRom*)
            printf '%s\n' "MaskRom device detected; loading download.bin."
            run_tool db "$images/download.bin"
            ;;
        *Loader*|*LOADER*)
            printf '%s\n' "Loader device detected."
            ;;
        *)
            printf '%s\n' "error: no Rockchip Loader or MaskRom device was detected." >&2
            printf '%s\n' "$device_info" >&2
            exit 1
            ;;
    esac
fi

printf '%s\n' "Flashing all eMMC partitions; userdata will be overwritten."
run_tool wl 0x0 0x40 "$images/env.img"
run_tool wl 0x40 0x400 "$images/idblock.img"
run_tool wl 0x440 0x2000 "$images/uboot.img"
run_tool wl 0x2440 0x5800 "$images/boot.img"
run_tool wl 0x7C40 0x200000 "$images/userdata.img"
run_tool wl 0x207C40 0x400000 "$images/oem.img"
run_tool wl 0x607C40 "$images/rootfs.img"
run_tool rd

if [ "$dry_run" = true ]; then
    printf '%s\n' "Dry run completed; no device was accessed."
else
    printf '%s\n' "Flash completed; the board was reset."
fi
