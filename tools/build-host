#!/bin/sh
# Configure and build the native host-viewer scaffold.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
build_dir=${1:-"$root/build/host"}

cmake -S "$root" -B "$build_dir" \
    -DCMAKE_BUILD_TYPE=Release \
    -DTELEOP_BUILD_AURA_SENDER=OFF \
    -DTELEOP_BUILD_HOST_VIEWER=ON
cmake --build "$build_dir"

printf '%s\n' "built: $build_dir/bin/host-viewer"
