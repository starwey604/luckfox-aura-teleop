#!/bin/sh
# Configure the native transport sender and receiver for execution on the host.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
build_dir=${1:-"$root/build/host"}

cmake -S "$root" -B "$build_dir" \
    -DCMAKE_BUILD_TYPE=Release \
    -DTELEOP_BUILD_AURA_SENDER=OFF \
    -DTELEOP_BUILD_TRANSPORT_TEST_SENDER=ON \
    -DTELEOP_BUILD_HOST_VIEWER=ON \
    -DTELEOP_BUILD_USB_CAMERA_SENDER=ON \
    -DTELEOP_BUILD_LATENCY_STIMULUS=ON
cmake --build "$build_dir"

printf '%s\n' "built: $build_dir/bin/transport-test-sender, host-viewer, usb-camera-sender, and latency-stimulus"
