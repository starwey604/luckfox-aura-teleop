#!/usr/bin/env python3
"""Bounded SSH sender + native VAAPI/transport test; preserves baseline binaries."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
MINIMAL_SNAPSHOT = """cat /proc/uptime /proc/meminfo
for p in /sys/class/thermal/thermal_zone*/temp; do echo "$p"; cat "$p"; done
ps
"""
SNAPSHOT = """cat /proc/uptime /proc/stat /proc/meminfo /proc/net/snmp /proc/net/softnet_stat
cat /proc/interrupts
for p in /sys/class/thermal/thermal_zone*/temp /sys/class/devfreq/*/cur_freq; do echo "$p"; cat "$p"; done
ethtool -S eth0
ps
for p in /proc/mpp_service/sessions-summary /proc/mpp_service/rkvenc0/sessions-info /proc/kmpp/sys/mem_pool_info /proc/kmpp/sys/shm_pool_info; do echo "$p"; cat "$p"; done
dmesg | tail -80
"""
MONITOR = """echo monitor_pid=$$
cat /dev/kmsg & kmsg_pid=$!
trap 'kill "$kmsg_pid" 2>/dev/null || true; wait "$kmsg_pid" 2>/dev/null || true; exit 0' TERM INT HUP
while :; do
echo sample
cat /proc/uptime /proc/stat /proc/net/snmp
for p in /sys/class/thermal/thermal_zone*/temp /sys/class/devfreq/*/cur_freq; do echo "$p"; cat "$p"; done
for p in /proc/[0-9]*/comm; do
read name 2>/dev/null < "$p" || continue
case "$name" in teleop-sender*)
pid=$(dirname "$p")
cat "$pid/stat" "$pid/status"
for t in "$pid"/task/*; do echo "$t"; cat "$t/stat" "$t/wchan" "$t/stack"; done
;; esac
done
sleep 1
done
"""

def host_policy_snapshot():
    def read(path):
        try: return Path(path).read_text().strip()
        except OSError: return None
    profile = None
    if shutil.which("powerprofilesctl"):
        result = subprocess.run(["powerprofilesctl", "get"], text=True, capture_output=True, timeout=5)
        if result.returncode == 0: profile = result.stdout.strip()
    return {"profile": profile,
        "cpu_policies": {str(p): {name: read(p / name) for name in (
            "scaling_governor", "energy_performance_preference", "scaling_min_freq", "scaling_max_freq", "scaling_cur_freq")}
            for p in Path("/sys/devices/system/cpu/cpufreq").glob("policy*")},
        "gpu_power_level": read("/sys/class/drm/renderD128/device/power_dpm_force_performance_level"),
        "sched_ext": read("/sys/kernel/sched_ext/state"),
        "host_temperatures": {str(p): read(p) for p in Path("/sys/class/hwmon").glob("hwmon*/temp*_input")}}


def controls_script(camera, vertical_blanking, sysfs_root="/sys/class/video4linux", exposure=735,
                    analogue=32, digital=512):
    # Keep wildcard prefixes active; quote the spaces in the sensor names.
    patterns = {"0": '*"ar0234 4-0010"', "1": '*"ar0234 3-0010"',
                "dual": '*"ar0234 4-0010"|*"ar0234 3-0010"'}
    vblank = "" if vertical_blanking is None else (
        f'v4l2-ctl -d "/dev/$node" --set-ctrl=vertical_blanking={vertical_blanking} || exit\n')
    expected = 2 if camera == "dual" else 1
    return f'''matched=0
for p in {shlex.quote(str(sysfs_root))}/v4l-subdev*; do
case "$(cat "$p/name")" in {patterns[camera]})
node=$(basename "$p")
{vblank}v4l2-ctl -d "/dev/$node" --set-ctrl=exposure={exposure},analogue_gain={analogue},digital_gain={digital},test_pattern=0 || exit
matched=$((matched + 1))
;; esac
done
[ "$matched" -eq {expected} ] || {{ echo "Expected {expected} AR0234 sensor nodes, found $matched" >&2; exit 1; }}
'''

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--camera", choices=("0", "1", "dual"), required=True)
    parser.add_argument("--frames", type=int, default=120, help="Frames per camera; short tests by default")
    parser.add_argument("--allow-long", action="store_true", help="Explicitly allow more than 300 frames after cooling is arranged")
    parser.add_argument("--start-temp-c", type=int, default=70, help="Refuse camera start at or above this temperature")
    parser.add_argument("--vertical-blanking", type=int, help="Optional diagnostic sensor VBLANK; changes capture fps")
    parser.add_argument("--exposure-lines", type=int, default=735, help="Sensor integration lines (default: 735)")
    parser.add_argument("--analogue-gain", type=int, default=32, help="Sensor gain register code, not a multiplier (default: 32)")
    parser.add_argument("--digital-gain", type=int, default=512, help="Sensor digital gain code (default: 512)")
    parser.add_argument("--port", type=int, default=5000)
    parser.add_argument("--mode", choices=("decode", "transport"), default="decode")
    parser.add_argument("--output-mode", choices=("frame", "slice"), default="frame")
    parser.add_argument("--force-stream-parser", action="store_true", help="Diagnostic viewer lookahead control")
    parser.add_argument("--minimal", action="store_true",
                        help="Direct sender, no live kernel/thread monitor or stage metrics; isolate observer effects")
    parser.add_argument("--record-h264", action="store_true",
                        help="Save both Annex-B streams in the board report directory (dual diagnostic only)")
    parser.add_argument("--host", default="root@192.168.1.10")
    parser.add_argument("--sender", default="/userdata/teleop-sender")
    parser.add_argument("--launcher", default="/userdata/run-ar0234-stereo", help="Board stereo launcher path")
    parser.add_argument("--viewer-pipeline", choices=("sync", "async"), default="async",
                        help="Host RX/decode/display architecture control")
    parser.add_argument("--rx-batch-size", type=int, choices=range(1, 33), default=16,
                        help="Async nonblocking receive batch limit; 1 is the recvmsg control")
    parser.add_argument("--rx-cpu", type=int)
    parser.add_argument("--decode0-cpu", type=int)
    parser.add_argument("--decode1-cpu", type=int)
    parser.add_argument("--rx-rr-priority", type=int, default=0)
    parser.add_argument("--cpu-latency-us", type=int)
    parser.add_argument("--display", action="store_true", help="Native VAAPI/Vulkan window instead of headless")
    parser.add_argument("--queue-report-ms", type=int, default=0, help="Optional live async queue snapshots")
    parser.add_argument("--viewer", type=Path, default=ROOT / "build/host-metrics/bin/host-viewer")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if args.cpu_latency_us is not None and not 0 <= args.cpu_latency_us <= 10000: parser.error("Invalid CPU idle latency")
    if any(cpu is not None and cpu < 0 for cpu in (args.rx_cpu, args.decode0_cpu, args.decode1_cpu)) or not 0 <= args.rx_rr_priority <= 99:
        parser.error("Invalid CPU/RT priority")
    if args.viewer_pipeline != "async" and (any(cpu is not None for cpu in (args.rx_cpu, args.decode0_cpu, args.decode1_cpu)) or args.rx_rr_priority):
        parser.error("Worker scheduling options require async")
    if args.queue_report_ms < 0 or args.queue_report_ms > 60000 or (args.viewer_pipeline == "sync" and args.queue_report_ms):
        parser.error("Queue reports need async and 0..60000 ms")
    if args.display and args.mode == "transport": parser.error("Display requires decode mode")
    if args.record_h264 and (args.camera != "dual" or args.minimal):
        parser.error("H.264 recording requires non-minimal dual launcher")
    if args.vertical_blanking is not None and args.vertical_blanking < 21:
        parser.error("AR0234 VBLANK must be >=21")
    if not 2 <= args.exposure_lines <= 65534:
        parser.error("AR0234 exposure must be 2..65534 lines")
    if not 13 <= args.analogue_gain <= 64 or not 128 <= args.digital_gain <= 2047:
        parser.error("AR0234 gain codes require analogue=13..64, digital=128..2047")
    if args.frames <= 0 or not 0 < args.port < 65536:
        parser.error("Invalid frame count/port")
    if args.frames > 300 and not args.allow_long:
        parser.error("Short-test policy: use <=300 frames; longer runs require --allow-long")
    if not 1 <= args.start_temp_c <= 100:
        parser.error("Invalid start temperature")
    if Path("/run/.containerenv").exists() or Path("/.dockerenv").exists():
        parser.error("Run natively, not in Distrobox")
    args.output.mkdir(parents=True, exist_ok=False)
    (args.output / "host-policy-before.json").write_text(json.dumps(host_policy_snapshot(), indent=2) + "\n")
    ssh = ["ssh", "-o", "ConnectTimeout=5", "-o", "ServerAliveInterval=3",
           "-o", "ServerAliveCountMax=3", "-o", "StrictHostKeyChecking=accept-new", args.host]
    if "SSHPASS" in os.environ:
        ssh = ["sshpass", "-e"] + ssh
    def remote(command, timeout=20):
        return subprocess.run(ssh + [command], text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, timeout=timeout)
    snapshot = MINIMAL_SNAPSHOT if args.minimal else SNAPSHOT
    before = remote(snapshot)
    (args.output / "board-before.txt").write_text(before.stdout)
    if before.returncode != 0:
        raise RuntimeError("Board preflight failed")
    temperatures = [int(value) for value in re.findall(
        r"/sys/class/thermal/thermal_zone\d+/temp\n(\d+)", before.stdout)]
    if not temperatures:
        raise RuntimeError("No thermal reading; camera test was not started")
    if max(temperatures) >= args.start_temp_c * 1000:
        raise RuntimeError("Board is too warm for short-test policy; let it cool before retrying")
    for line in before.stdout.splitlines():
        if re.search(r"^\s*\d+\s+\S+\s+\S+\s+(?:/\S*/)?(?:teleop-sender\S*|v4l2-ctl|rkipc)(?:\s|$)", line):
            raise RuntimeError("Existing camera application: " + line)
    with socket.socket(socket.AF_INET6, socket.SOCK_DGRAM) as check:
        check.bind(("::", args.port))
    result = {"camera": args.camera, "frames_per_camera": args.frames,
              "rx_batch_size": args.rx_batch_size, "viewer_pipeline": args.viewer_pipeline, "display": args.display, "queue_report_ms": args.queue_report_ms,
              "cpu_latency_us": args.cpu_latency_us,
              "worker_scheduling": {"rx_cpu": args.rx_cpu, "decode0_cpu": args.decode0_cpu, "decode1_cpu": args.decode1_cpu, "rx_rr_priority": args.rx_rr_priority},
              "mode": args.mode, "port": args.port, "vertical_blanking": args.vertical_blanking,
              "exposure_lines": args.exposure_lines,
              "analogue_gain": args.analogue_gain, "digital_gain": args.digital_gain,
              "output_mode": args.output_mode, "force_stream_parser": args.force_stream_parser,
              "minimal": args.minimal, "success": False}
    limit = max(20, args.frames // 90 + 20)
    directory = "/userdata/latency-" + args.output.parent.name + "-" + args.output.name
    result["record_h264_directory"] = directory + "/h264" if args.record_h264 else None
    if args.camera == "dual" and not args.minimal:
        # Preserve directory metadata even if the board locks before ext4's
        # periodic journal commit. Stream log contents to the host as well.
        prepared = remote("mkdir -p " + shlex.quote(directory) + " && sync")
        if prepared.returncode != 0: raise RuntimeError("Could not prepare board report directory")
    logs = {name: (args.output / (name + ".txt")).open("w")
            for name in ("monitor", "viewer", "sender")}
    monitor = viewer = sender = mirror = None
    mirror_log = (args.output / "board-live-logs.txt").open("w")
    started = time.monotonic()
    try:
        if not args.minimal:
            monitor = subprocess.Popen(ssh + ["sh -c " + shlex.quote(MONITOR) + " aura-metrics-monitor"],
                                       stdout=logs["monitor"], stderr=subprocess.STDOUT)
        if args.camera == "dual" and not args.minimal:
            command = ["timeout", "-s", "TERM", "-k", "2", str(limit + 20), "tail", "-n", "+1", "-F",
                       directory + "/stereo.log"]
            mirror_command = 'echo mirror_pid=$$; exec ' + shlex.join(command)
            mirror = subprocess.Popen(ssh + ['sh -c ' + shlex.quote(mirror_command)], stdout=mirror_log,
                                      stderr=subprocess.STDOUT)
        streams = 2 if args.camera == "dual" else 1
        command = [str(args.viewer), "--port", str(args.port), "--pipeline", args.viewer_pipeline, "--rx-batch-size", str(args.rx_batch_size),
                   "--frames", str(args.frames * streams), "--timeout-ms", "60000"]
        for flag, cpu in (("--rx-cpu", args.rx_cpu), ("--decode0-cpu", args.decode0_cpu), ("--decode1-cpu", args.decode1_cpu)):
            if cpu is not None: command += [flag, str(cpu)]
        if args.cpu_latency_us is not None: command += ["--cpu-latency-us", str(args.cpu_latency_us)]
        if args.rx_rr_priority: command += ["--rx-rr-priority", str(args.rx_rr_priority)]
        if not args.display: command += ["--headless"]
        if args.queue_report_ms: command += ["--queue-report-ms", str(args.queue_report_ms)]
        if args.camera != "0": command += ["--dual-stream"]
        if args.mode == "transport": command += ["--transport-only"]
        if args.force_stream_parser: command += ["--force-stream-parser"]
        result["viewer_command"] = command
        metrics = "0" if args.minimal else "1"
        viewer = subprocess.Popen(command, env=dict(os.environ, TELEOP_METRICS=metrics),
                                  stdout=logs["viewer"], stderr=subprocess.STDOUT)
        deadline = time.monotonic() + 10
        while True:
            if viewer.poll() is not None: raise RuntimeError("Viewer exited before binding")
            with socket.socket(socket.AF_INET6, socket.SOCK_DGRAM) as check:
                try: check.bind(("::", args.port))
                except OSError: break
            if time.monotonic() > deadline: raise RuntimeError("Viewer bind timeout")
            time.sleep(0.01)
        print("Receiver bound; starting board test", flush=True)
        if args.camera == "dual" and not args.minimal:
            command = ["env", "TELEOP_METRICS=1", "AURA_LIFECYCLE_TRACE=1", "SENDER=" + args.sender,
                       "PORT=" + str(args.port), "WRAP_LINES=0",
                       "EXPOSURE=" + str(args.exposure_lines),
                       "ANALOGUE_GAIN=" + str(args.analogue_gain), "DIGITAL_GAIN=" + str(args.digital_gain),
                       "OUTPUT_MODE=" + args.output_mode,
                       "REPORT_DIR=" + directory,
                       args.launcher, "--frames", str(args.frames)]
            if args.record_h264:
                command.insert(2, "H264_DIR=" + directory + "/h264")
            if args.vertical_blanking is not None: command.insert(2, "VERTICAL_BLANKING=" + str(args.vertical_blanking))
            controls = ""
        else:
            controls = controls_script(args.camera, args.vertical_blanking, exposure=args.exposure_lines,
                                       analogue=args.analogue_gain, digital=args.digital_gain)
            camera_flags = ["--dual"] if args.camera == "dual" else ["--camera", args.camera]
            command = ["env", "TELEOP_METRICS=" + metrics, "AURA_LIFECYCLE_TRACE=" + metrics, args.sender] + camera_flags + [
                       "--width", "1280", "--height", "720", "--fps", "100",
                       "--wrap-lines", "0", "--port", str(args.port), "--frames", str(args.frames)]
            command += ["--output-mode", args.output_mode]
        command = controls + "timeout -s INT -k 5 " + str(limit) + " " + shlex.join(command)
        result["sender_command"] = command
        sender = subprocess.Popen(ssh + [command], stdout=logs["sender"], stderr=subprocess.STDOUT)
        result["sender_exit"] = sender.wait(timeout=limit + 15)
        if result["sender_exit"] in (130, 143):
            result["interrupted"] = True
            raise RuntimeError("Test interrupted; partial run, not automatically classified as a crash")
        if result["sender_exit"] != 0: raise RuntimeError("Sender/SSH failed")
        result["viewer_exit"] = viewer.wait(timeout=15)
        if result["viewer_exit"] != 0: raise RuntimeError("Viewer failed")
        if args.camera == "dual" and not args.minimal:
            reports = remote("cat " + shlex.quote(directory + "/stereo.log"))
            (args.output / "board-senders.txt").write_text(reports.stdout)
        logs["viewer"].flush()
        text = (args.output / "viewer.txt").read_text()
        if f"access_units={args.frames * streams} " not in text or "malformed=0 duplicates=0 dropped=0" not in text:
            raise RuntimeError("Incomplete/corrupt transport statistics")
        if args.mode == "decode":
            if text.count(f"decoder: frames={args.frames} hardware_frames={args.frames}") != streams:
                raise RuntimeError("Incomplete hardware decode")
            if re.search(r"\[h264 @|host-viewer:", text): raise RuntimeError("Decoder warnings/errors")
        result["success"] = True
    except (RuntimeError, subprocess.TimeoutExpired) as error:
        result["error"] = str(error)
        print("FAIL:", error, flush=True)
    finally:
        if mirror is not None:
            mirror_log.flush()
            owned = re.search(r"^mirror_pid=(\d+)$", (args.output / "board-live-logs.txt").read_text(), re.M)
            if owned:
                pid = owned[1]
                try:
                    remote(f"tr '\\000' ' ' < /proc/{pid}/cmdline | grep -Fq " +
                           shlex.quote(directory + "/stereo.log") + f" && kill -TERM {pid}", timeout=10)
                except subprocess.TimeoutExpired: pass
        for process in (sender, viewer, mirror):
            if process is not None and process.poll() is None:
                process.terminate()
                try: process.wait(timeout=5)
                except subprocess.TimeoutExpired: process.kill(); process.wait()
        if monitor is not None:
            logs["monitor"].flush()
            match = re.search(r"^monitor_pid=(\d+)$", (args.output / "monitor.txt").read_text(), re.M)
            if match:
                pid = match[1]
                try:
                    remote(f"tr '\\000' ' ' < /proc/{pid}/cmdline | grep -Fq aura-metrics-monitor && kill -TERM {pid}", timeout=10)
                except subprocess.TimeoutExpired: pass
            if monitor.poll() is None:
                monitor.terminate()
                try: monitor.wait(timeout=5)
                except subprocess.TimeoutExpired: monitor.kill(); monitor.wait()
        for log in logs.values(): log.close()
        mirror_log.close()
        try:
            after = remote(snapshot, timeout=12)
            (args.output / "board-after.txt").write_text(after.stdout)
            result["board_responds_after"] = after.returncode == 0
        except subprocess.TimeoutExpired: result["board_responds_after"] = False
        (args.output / "host-policy-after.json").write_text(json.dumps(host_policy_snapshot(), indent=2) + "\n")
        result["elapsed_seconds"] = time.monotonic() - started
        (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result, indent=2), flush=True)
    return 0 if result["success"] and result.get("board_responds_after") else 1

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
        print("test-aura-software-baseline:", error, file=sys.stderr)
        sys.exit(1)
