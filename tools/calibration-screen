#!/usr/bin/env python3
"""Serve a remotely controlled camera colour target; Python standard library only."""
import argparse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
import re
import threading
from urllib.error import URLError
from urllib.request import Request, urlopen


PRESETS = {
    "black": "#000000", "darkgray": "#202020", "gray": "#808080",
    "white": "#c0c0c0", "fullwhite": "#ffffff",
    "red": "#c00000", "green": "#00c000", "blue": "#0000c0",
    "yellow": "#c0c000", "cyan": "#00c0c0", "magenta": "#c000c0",
    "chart": None, "grayramp": None,
}
PAGE = Path(__file__).with_name("calibration-screen-assets") / "index.html"


def target(value):
    value = value.lower()
    if value not in PRESETS and not re.fullmatch(r"#[0-9a-f]{6}", value):
        raise ValueError("Expected a preset or #RRGGBB: " + ", ".join(PRESETS))
    return value


class Server(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, address, initial):
        self.lock = threading.Lock()
        self.state = {"target": initial, "revision": 0}
        self.page = PAGE.read_bytes()
        super().__init__(address, Handler)

    def snapshot(self):
        with self.lock:
            return dict(self.state)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        # Polling should not fill the terminal. Changes are logged separately.
        pass

    def reply(self, code, body, content_type="application/json; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self):
        if self.path == "/":
            self.reply(200, self.server.page, "text/html; charset=utf-8")
        elif self.path == "/api/state":
            self.reply(200, json.dumps(self.server.snapshot()).encode())
        else:
            self.reply(404, b'{"error":"not found"}')

    def do_POST(self):
        if self.path != "/api/state":
            self.reply(404, b'{"error":"not found"}')
            return
        # Browser updates must originate from this page, not another website.
        origin = self.headers.get("Origin")
        if origin and origin != "http://" + self.headers.get("Host", ""):
            self.reply(403, b'{"error":"foreign origin"}')
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if not 0 < length <= 1024:
                raise ValueError("Expected 1..1024 bytes")
            if self.headers.get_content_type() != "application/json":
                raise ValueError("Expected application/json")
            body = json.loads(self.rfile.read(length))
            value = target(body["target"])
        except (ValueError, KeyError, TypeError, AttributeError) as exc:
            self.reply(400, json.dumps({"error": str(exc)}).encode())
            return
        with self.server.lock:
            self.server.state["target"] = value
            self.server.state["revision"] += 1
            state = dict(self.server.state)
        print(f"target={value} revision={state['revision']}", flush=True)
        self.reply(200, json.dumps(state).encode())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--bind", default="0.0.0.0", help="Server listening address")
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--initial", default="gray", help="Initial preset or #RRGGBB")
    parser.add_argument("--set", metavar="TARGET", help="Change a running server's target and exit")
    parser.add_argument("--url", help="Control URL; default http://127.0.0.1:PORT")
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("port must be 1..65535")
    try:
        value = target(args.set if args.set is not None else args.initial)
    except ValueError as exc:
        parser.error(str(exc))
    if args.set is not None:
        base = args.url or f"http://127.0.0.1:{args.port}"
        request = Request(base.rstrip("/") + "/api/state",
                          data=json.dumps({"target": value}).encode(),
                          headers={"Content-Type": "application/json"}, method="POST")
        try:
            with urlopen(request, timeout=5) as response:
                print(response.read().decode())
        except (OSError, URLError) as exc:
            parser.exit(1, f"Could not change target: {exc}\n")
        return
    with Server((args.bind, args.port), value) as server:
        print(f"Camera target listening on http://{args.bind}:{args.port}/", flush=True)
        print("Tablet: open this computer's Wi-Fi IP at that port.", flush=True)
        print(f"Control: {Path(__file__).name} --port {args.port} --set red", flush=True)
        print("Stop: Ctrl+C. No camera is started by this server.", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    main()
