#!/usr/bin/env python3
"""Compare nonblocking UDP batch limits with bounded real-board stereo captures."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--viewer', type=Path, default=ROOT / 'build/host/bin/host-viewer')
    parser.add_argument('--rounds', type=int, choices=range(1, 4), default=3,
                        help='1..3 headless comparison rounds; four display runs follow')
    parser.add_argument('--minimal', action='store_true', help='Disable detailed stage/board polling observers')
    parser.add_argument('--no-display', action='store_true', help='Headless rounds only')
    parser.add_argument('--host', default='root@192.168.1.10')
    parser.add_argument('--adb-serial', default='4a988b5514157df5')
    args = parser.parse_args()
    if Path('/run/.containerenv').exists() or Path('/.dockerenv').exists():
        parser.error('Run on the native CachyOS host')
    args.output.mkdir(parents=True, exist_ok=False)
    ssh = ['ssh', '-o', 'ConnectTimeout=5', args.host]
    if 'SSHPASS' in os.environ:
        ssh = ['sshpass', '-e', *ssh]
    def remote(command):
        return subprocess.check_output([*ssh, command], text=True, timeout=15).strip()
    adb = ['adb', '-s', args.adb_serial, 'shell']
    boot = remote('cat /proc/sys/kernel/random/boot_id')
    identity = remote('uname -a; sha256sum /userdata/teleop-sender /userdata/run-ar0234-stereo; '
                      'cat /sys/class/thermal/thermal_zone0/temp')
    (args.output / 'board-identity.txt').write_text(identity + '\n')
    runs = []
    capture = None
    reader_pid = None
    marker = f'teleop-viewer-rx-batch-{time.monotonic_ns()}'
    kmsg = args.output / 'usb-kmsg.txt'
    with kmsg.open('w') as log:
        try:
            # Owned reader shell traps TERM/HUP and reaps its own cat child.
            command = "timeout 240 sh -c 'echo usb_reader_pid=$$; cat /dev/kmsg & child=$!; " \
                      "trap \"kill $child 2>/dev/null; wait $child 2>/dev/null; exit 0\" TERM INT HUP; wait $child'"
            capture = subprocess.Popen([*adb, command], stdout=log, stderr=subprocess.STDOUT)
            time.sleep(.3)
            subprocess.run([*adb, f'echo {marker} >/dev/kmsg'], check=True, timeout=10,
                           stdout=subprocess.DEVNULL)
            deadline = time.monotonic() + 5
            while marker not in kmsg.read_text(errors='replace'):
                if capture.poll() is not None or time.monotonic() >= deadline:
                    raise RuntimeError('USB live marker not received; no cameras started')
                time.sleep(.05)
            reader_pid = re.search(r'^usb_reader_pid=(\d+)', kmsg.read_text(), re.M)[1]
            orders = [(1, 8, 16, 32), (32, 16, 8, 1), (8, 1, 32, 16)]
            cases = [(f'headless-{index + 1}-batch-{size}', size, False)
                     for index in range(args.rounds) for size in orders[index]]
            if not args.no_display:
                cases += [(f'display-batch-{size}', size, True) for size in (1, 8, 16, 32)]
            for name, size, display in cases:
                if remote('cat /proc/sys/kernel/random/boot_id') != boot:
                    raise RuntimeError('Board rebooted; stop')
                path = args.output / name
                command = [str(ROOT / 'tools/test-aura-software-baseline'), '--camera', 'dual',
                           '--frames', '120', '--viewer', str(args.viewer), '--viewer-pipeline', 'async', '--rx-batch-size', str(size),
                           '--host', args.host, '--output', str(path)]
                if display:
                    command += ['--display']
                if args.minimal: command += ['--minimal']
                else: command += ['--queue-report-ms', '250']
                subprocess.run(command, check=True, timeout=60)
                text = (path / 'viewer.txt').read_text()
                result = json.loads((path / 'result.json').read_text())
                if 'rxq_overflow=0' not in text:
                    raise RuntimeError('RX overflow or missing observer')
                if len(re.findall(r'queue: stream=\d .*overflows=0', text)) != 2:
                    raise RuntimeError('Encoded queue overflow or missing observations')
                metrics = {}
                for line in text.splitlines():
                    if line.startswith('metric:'):
                        values = dict(re.findall(r'(\w+)=([^ ]+)', line))
                        stage = values.pop('stage')
                        metrics[stage] = {key: float(value) for key, value in values.items()}
                def counters(prefix):
                    line = next(line for line in text.splitlines() if line.startswith(prefix))
                    return {key: float(value) for key, value in re.findall(r'(\w+)=([^ ]+)', line)}
                rx = counters('rx-thread:')
                calls = counters('rx-syscalls:')
                timestamps = int(re.search(r'kernel_timestamps=(\d+)', text)[1])
                if timestamps != (0 if args.minimal else calls['datagrams']):
                    raise RuntimeError('Per-packet timestamp metadata missing or wrong observer mode')
                if 'truncated=0 clock_discontinuities=0' not in text or 'overflow=enabled' not in text:
                    raise RuntimeError('Ancillary truncation, clock discontinuity or unavailable overflow observer')
                runs.append({'name': name, 'batch_size': size, 'display': display, 'result': result,
                             'rx_thread': rx, 'rx_syscalls': calls, 'metrics': metrics,
                             'rx_cpu_us_per_datagram': rx['cpu_ms'] * 1000 / calls['datagrams']})
                if re.search(r'BUG:|WARNING:|soft lockup|hard LOCKUP',
                             kmsg.read_text(errors='replace').split(marker, 1)[1]):
                    raise RuntimeError('Kernel fault after USB marker; stop')
            if remote('cat /proc/sys/kernel/random/boot_id') != boot:
                raise RuntimeError('Board rebooted during final test')
            (args.output / 'board-after.txt').write_text(remote(
                'cat /sys/class/thermal/thermal_zone0/temp; ps; cat /proc/net/snmp') + '\n')
        finally:
            if reader_pid:
                subprocess.run([*adb, f'kill {reader_pid}'], timeout=10,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if capture and capture.poll() is None:
                capture.terminate()
                capture.wait(timeout=10)
    aggregate = {}
    for size in (1, 8, 16, 32):
        selected = [run for run in runs if run['batch_size'] == size and not run['display']]
        packets = sum(run['rx_syscalls']['datagrams'] for run in selected)
        cpu = sum(run['rx_thread']['cpu_ms'] for run in selected)
        aggregate[str(size)] = {
            'runs': len(selected), 'rx_cpu_ms_per_run': cpu / len(selected),
            'rx_cpu_us_per_datagram': cpu * 1000 / packets,
            'poll_calls_per_run': sum(run['rx_thread']['poll_calls'] for run in selected) / len(selected),
            'recv_calls_per_run': sum(run['rx_syscalls']['calls'] for run in selected) / len(selected),
            'mean_actual_batch': packets / sum(run['rx_syscalls']['successful_calls'] for run in selected),
        }
        stage = 'host.kernel_rx_to_user'
        values = [run['metrics'][stage] for run in selected if stage in run['metrics']]
        if values:
            aggregate[str(size)]['kernel_rx'] = {
                'weighted_mean_ms': sum(value['mean'] * value['samples'] for value in values) / sum(value['samples'] for value in values),
                'p95_run_range_ms': [min(value['p95'] for value in values), max(value['p95'] for value in values)],
                'p99_run_range_ms': [min(value['p99'] for value in values), max(value['p99'] for value in values)],
                'max_ms': max(value['max'] for value in values),
            }
    summary = {'headless_aggregate': aggregate, 'boot_id': boot, 'viewer_sha256': hashlib.sha256(args.viewer.read_bytes()).hexdigest(),
               'hardware_frames': len(runs) * 240, 'frames_per_camera_per_run': 120,
               'runs': runs, 'minimal': args.minimal, 'measurement': 'local software stages; no optical or cross-host latency'}
    (args.output / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(f'PASS: {len(runs)} short stereo runs / {summary["hardware_frames"]} hardware frames')


if __name__ == '__main__':
    main()
