#!/bin/sh
# Run on Aura alongside diagnose-ar0234. Manage only this script's children.
set -eu

usage() {
    echo 'usage: run-ar0234-stereo [--capture-only] [--frames N] [--dry-run]'
    echo 'Environment: DESTINATION=192.168.1.2 PORT=5000 FPS=120 BITRATE_KBPS=30000'
    echo '             EXPOSURE=735 ANALOGUE_GAIN=48 DIGITAL_GAIN=512 REPORT_DIR=/path'
    echo '             WRAP_LINES=0 (full-frame path for stereo; mono sender defaults to 256)'
    echo '             OUTPUT_MODE=frame (SDK mode1 immediate AU); slice retains mode3 PTS grouping'
    echo '             VERTICAL_BLANKING=506 (requires #19 fastreadout; ~119.95 capture fps)'
    echo '             For the previous ~99.23fps timing: VERTICAL_BLANKING=762 FPS=100'
    echo '             H264_DIR=/path (optional per-camera Annex-B recordings)'
    echo '             STARTUP_TIMEOUT=15 (wait for the shared sender to finish initialization)'
    echo '             GOP=15 SLICE_CTUS=0 ENTROPY=cavlc TRANSFORM=4x4'
    echo '             Requires the codec-capable sender; 0 disables slice splitting'
    echo '             Optional: RC_MODE=cbr|fixqp QP_I=26 QP_P=26 PROFILE=high|main|baseline'
    echo '             ENTROPY=cabac|cavlc TRANSFORM=auto|4x4 override the defaults'
    echo '             DEBLOCK=on|off MAX_REENCODE=0..3 CODEC_REPORT=1'
}

mode=sender
frames=0
dry_run=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        --capture-only) mode=capture; shift ;;
        --dry-run) dry_run=true; shift ;;
        --frames) [ "$#" -ge 2 ] || exit 2; frames=$2; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done
case "$frames" in ''|*[!0-9]*) echo 'invalid frame count' >&2; exit 2 ;; esac
if [ "$mode" = capture ] && [ "$frames" -eq 0 ]; then frames=600; fi
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
diagnostic=${DIAGNOSTIC:-"$dir/diagnose-ar0234"}
sender=${SENDER:-/userdata/teleop-sender}
sys=${SYS_ROOT:-/sys}
dev=${DEV_ROOT:-/dev}
destination=${DESTINATION:-192.168.1.2}
port=${PORT:-5000}
fps=${FPS:-120}
vertical_blanking=${VERTICAL_BLANKING:-506}
bitrate=${BITRATE_KBPS:-30000}
gop=${GOP:-15}
slice_ctus=${SLICE_CTUS:-0}
entropy=${ENTROPY:-cavlc}
transform=${TRANSFORM:-4x4}
exposure=${EXPOSURE:-735}
analogue=${ANALOGUE_GAIN:-48}
digital=${DIGITAL_GAIN:-512}
wrap_lines=${WRAP_LINES:-0}
output_mode=${OUTPUT_MODE:-frame}
case "$output_mode" in frame|slice) ;; *) echo 'invalid OUTPUT_MODE' >&2; exit 2 ;; esac
startup_timeout=${STARTUP_TIMEOUT:-15}
for number in "$port" "$fps" "$vertical_blanking" "$bitrate" "$gop" "$slice_ctus" "$exposure" "$analogue" "$digital" "$wrap_lines" "$startup_timeout"; do
    case "$number" in ''|*[!0-9]*) echo 'expected decimal parameter' >&2; exit 2 ;; esac
done
if [ "$output_mode" = slice ] && [ "$slice_ctus" -eq 0 ]; then
    echo 'OUTPUT_MODE=slice requires SLICE_CTUS > 0' >&2
    exit 2
fi
[ -x "$diagnostic" ] || { echo "missing diagnostic: $diagnostic" >&2; exit 3; }
if [ "$mode" = sender ]; then
    [ -x "$sender" ] || { echo "missing sender: $sender" >&2; exit 3; }
fi
report=${REPORT_DIR:-$(mktemp -d /tmp/ar0234-stereo.XXXXXX)}
mkdir -p "$report"
echo "stereo reports: $report"

# Avoid sharing a capture node with an existing camera application.
for process in "${PROC_ROOT:-/proc}"/[0-9]*/comm; do
    [ -r "$process" ] || continue
    name=$(cat "$process" 2>/dev/null) || continue
    case "$name" in
        teleop-sender*|aura-sender*|rkipc|rkisp_demo|v4l2-ctl)
            echo "camera application already running: $name ($process)" >&2
            exit 3 ;;
    esac
done

# Validate both cameras before changing either camera's controls or starting
# either process. The diagnostic resolves the Linux I2C bus from the DT alias.
for camera in 0 1; do
    if ! "$diagnostic" --camera "$camera" --probe --output "$report/camera$camera-probe" \
        > "$report/camera$camera-preflight.log" 2>&1; then
        cat "$report/camera$camera-preflight.log" >&2
        exit 3
    fi
    probe="$report/camera$camera-probe/report.txt"
    grep -q 'driver=ar0234' "$probe" || { echo "camera$camera driver not bound" >&2; exit 3; }
    bus=$(sed -n 's/^selected adapter=\([0-9][0-9]*\),.*/\1/p' "$probe")
    sensor=
    for node in "$sys"/class/video4linux/v4l-subdev*; do
        [ -r "$node/name" ] || continue
        name=$(cat "$node/name")
        case "$name" in *"ar0234 $bus-0010") sensor="$dev/${node##*/}"; break ;; esac
    done
    [ -n "$bus" ] && [ -n "$sensor" ] || { echo "camera$camera sensor node missing" >&2; exit 3; }
    printf '%s\n' "$sensor" > "$report/camera$camera-sensor"
    echo "camera$camera: I2C $bus:0x10 sensor=$sensor stream/VENC=$camera"
done

if [ "$dry_run" = true ]; then
    echo "dry run: $mode, 1280x720, frames=$frames, destination=$destination:$port, fps=$fps bitrate_kbps=$bitrate"
    echo "sensor controls: vertical_blanking=$vertical_blanking exposure=$exposure analogue_gain=$analogue digital_gain=$digital"
    echo "codec: gop=$gop slice_ctus=$slice_ctus output_mode=$output_mode entropy=$entropy transform=$transform"
    echo 'No control changes or capture/sender processes started.'
    exit 0
fi

pid0=
pid1=
cleanup() {
    for pid in "$pid0" "$pid1"; do
        [ -n "$pid" ] || continue
        kill -INT "$pid" 2>/dev/null || true
    done
    for pid in "$pid0" "$pid1"; do
        [ -n "$pid" ] || continue
        wait "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

for camera in 0 1; do
    sensor=$(cat "$report/camera$camera-sensor")
    v4l2-ctl -d "$sensor" --set-ctrl="vertical_blanking=$vertical_blanking"
    v4l2-ctl -d "$sensor" \
        --set-ctrl="exposure=$exposure,analogue_gain=$analogue,digital_gain=$digital,test_pattern=0"
done

start_capture() {
    camera=$1
    exec "$diagnostic" --camera "$camera" --capture --frames "$frames" \
        --timeout "$((frames / 20 + 20))" --output "$report/camera$camera-capture"
}
# MPI owns global resources: run both encoders in a single process/SYS session.
if [ "$mode" = sender ]; then
    if [ -n "${H264_DIR:-}" ]; then
        mkdir -p "$H264_DIR"
        set -- --output-h264 "$H264_DIR/camera{camera}.h264"
    else
        set --
    fi
    [ -z "${RC_MODE:-}" ] || set -- "$@" --rc-mode "$RC_MODE"
    [ -z "${QP_I:-}" ] || set -- "$@" --qp-i "$QP_I"
    [ -z "${QP_P:-}" ] || set -- "$@" --qp-p "$QP_P"
    [ -z "${PROFILE:-}" ] || set -- "$@" --profile "$PROFILE"
    set -- "$@" --entropy "$entropy" --transform "$transform"
    [ -z "${DEBLOCK:-}" ] || set -- "$@" --deblock "$DEBLOCK"
    [ -z "${MAX_REENCODE:-}" ] || set -- "$@" --max-reencode "$MAX_REENCODE"
    [ "${CODEC_REPORT:-0}" != 1 ] || set -- "$@" --codec-report
    "$sender" --dual --width 1280 --height 720 --fps "$fps" \
        --destination "$destination" --port "$port" --bitrate-kbps "$bitrate" \
        --wrap-lines "$wrap_lines" --gop "$gop" --slice-ctus "$slice_ctus" --output-mode "$output_mode" --frames "$frames" "$@" \
        > "$report/stereo.log" 2>&1 & pid0=$!
    deadline=$(( $(date +%s) + startup_timeout ))
    while ! grep -q 'aura-sender: VI 1/1/0' "$report/stereo.log"; do
        if ! kill -0 "$pid0" 2>/dev/null; then
            rc=0
            wait "$pid0" || rc=$?
            pid0=
            cat "$report/stereo.log" >&2
            [ "$rc" -ne 0 ] || rc=1
            exit "$rc"
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "sender startup timeout; see $report/stereo.log" >&2
            exit 1
        fi
        sleep 0.05
    done
    echo "stereo sender: $pid0; Ctrl+C stops both streams."
    rc=0
    wait "$pid0" || rc=$?
    pid0=
    echo "stereo exit=$rc; log: $report/stereo.log"
    exit "$rc"
fi

# Raw capture diagnostics remain independent V4L2 processes (no MPI SYS).
( start_capture 0 ) > "$report/camera0.log" 2>&1 & pid0=$!
( start_capture 1 ) > "$report/camera1.log" 2>&1 & pid1=$!
rc=0
wait "$pid0" || rc=$?
pid0=
if [ "$rc" -ne 0 ]; then exit "$rc"; fi
wait "$pid1" || rc=$?
pid1=
exit "$rc"
